<!-- /sections/section-news.liquid -->

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign blog = blogs[section.settings.blog_name]
  assign heading = section.settings.heading
  assign heading_tag = 'h2'
  assign article_heading_tag = 'h3'
  assign max_articles = 5
  assign article_count = blog.articles_count | default: 0
  assign visible_articles = blog.articles | slice: 0, max_articles
  assign animation_anchor = '#News--' | append: section.id
  assign default_heading = 'home_page.sections.news_title' | t

  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless

  case heading_tag
    when 'h1'
      assign article_heading_tag = 'h2'
    when 'h2'
      assign article_heading_tag = 'h3'
    when 'h3'
      assign article_heading_tag = 'h4'
    when 'h4'
      assign article_heading_tag = 'h5'
    when 'h5', 'h6'
      assign article_heading_tag = 'h6'
  endcase

  assign view_all_label = section.settings.view_all_label
  if view_all_label == blank
    assign view_all_label = 'sections.news.view_all' | t
  endif
-%}

{%- style -%}
  #News--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if article_count > 0 or request.design_mode -%}
  <section
    id="News--{{ section.id }}"
    class="news section-padding {{ color_scheme }}"
    data-section-id="{{ section.id }}"
    data-section-type="news"
    {% if heading != blank %}
      aria-labelledby="NewsHeading--{{ section.id }}"
    {% else %}
      aria-label="{{ default_heading | escape }}"
    {% endif %}
  >
    <div class="news__inner {{ section.settings.width }}">
      <header
        class="news__header"
        data-aos="hero"
        data-aos-anchor="{{ animation_anchor }}"
      >
        {%- if section.settings.subheading != blank -%}
          <p class="news__subheading subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <{{ heading_tag }} id="NewsHeading--{{ section.id }}" class="news__heading {{ section.settings.heading_font_size }}">
            {{- heading | escape -}}
          </{{ heading_tag }}>
        {%- endif -%}
      </header>

      <div class="news__content">
        {%- if article_count > 0 -%}
          <ul class="news__list" role="list">
            {%- for article in visible_articles -%}
              <li
                class="news__item"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ forloop.index | plus: 1 }}"
              >
                <article class="news__article">
                  <time
                    class="news__date body-small"
                    datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
                  >
                    {{- article.published_at | date: format: 'full_date' -}}
                  </time>

                  <{{ article_heading_tag }} class="news__article-title {{ section.settings.article_title_size }}">
                    <a href="{{ article.url }}">{{ article.title | escape }}</a>
                  </{{ article_heading_tag }}>

                  <span class="news__arrow" aria-hidden="true">
                    {%- render 'icon-nav-arrow-right' -%}
                  </span>
                </article>
              </li>
            {%- endfor -%}
          </ul>

          {%- if article_count > max_articles -%}
            <div
              class="news__footer"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ max_articles | plus: 2 }}"
            >
              <a
                href="{{ blog.url }}"
                class="btn {{ section.settings.button_style }} {{ section.settings.button_size }} {{ section.settings.button_type }}"
              >
                <span>{{ view_all_label | escape }}</span>
                {%- if section.settings.show_arrow -%}
                  {%- render 'icon-nav-arrow-right' -%}
                {%- endif -%}
              </a>
            </div>
          {%- endif -%}
        {%- elsif request.design_mode -%}
          <p class="news__empty body-medium">{{ 'blogs.article.no_articles' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- if article_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ heading | default: default_heading | json }},
      "numberOfItems": {{ visible_articles.size }},
      "itemListElement": [
        {%- for article in visible_articles -%}
          {%- assign absolute_article_url = article.url | prepend: shop.url -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ absolute_article_url | json }},
            "item": {
              "@type": "BlogPosting",
              "headline": {{ article.title | json }},
              "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
              "url": {{ absolute_article_url | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .news__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .news__header {
    align-self: start;
  }

  .news__subheading {
    display: inline-flex;
    width: fit-content;
    margin: 0 0 16px;
    padding: 7px 12px;
    border-radius: var(--radius);
    color: var(--BTN-PRIMARY-TEXT);
    background-color: var(--BTN-PRIMARY-BG);
    line-height: 1.2;
  }

  .news__heading {
    margin: 0;
  }

  .news__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .news__item {
    border-bottom: 1px solid var(--border);
  }

  .news__article {
    position: relative;
    display: grid;
    grid-template-columns: minmax(120px, 0.32fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    min-height: 88px;
    padding: 20px 0;
  }

  .news__date {
    color: var(--text-light);
    white-space: nowrap;
  }

  .news__article-title {
    margin: 0;
    line-height: 1.45;
  }

  .news__article-title a {
    color: inherit;
    text-decoration: none;
  }

  .news__article-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .news__article-title a:focus-visible {
    outline: none;
  }

  .news__article:has(.news__article-title a:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .news__arrow {
    display: inline-flex;
    color: var(--text);
    transition: transform 0.35s ease;
  }

  .news__arrow .icon {
    width: 20px;
    height: 20px;
  }

  .news__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 24px;
  }

  .news__empty {
    margin: 0;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  @media (hover: hover) {
    .news__article:hover .news__arrow {
      transform: translateX(5px);
    }

    .news__article-title a:hover {
      color: var(--text-hover);
    }
  }

  @media only screen and (max-width: 749px) {
    .news__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .news__article {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px 16px;
      min-height: 0;
      padding: 18px 0;
    }

    .news__date {
      grid-column: 1 / -1;
    }

    .news__article-title {
      grid-column: 1;
    }

    .news__arrow {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "News",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog_name",
      "label": "Blog",
      "info": "The five most recent published articles are shown."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Latest updates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "News"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "info": "Shown when the selected blog contains more than five published articles. Leave blank to use the translated default."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        {"value": "heading-mini", "label": "Mini"},
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"},
        {"value": "heading-large", "label": "Large"},
        {"value": "heading-x-large", "label": "Extra large"}
      ]
    },
    {
      "type": "select",
      "id": "article_title_size",
      "label": "Article title size",
      "default": "heading-x-small",
      "options": [
        {"value": "heading-mini", "label": "Mini"},
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"}
      ]
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Color",
      "default": "btn--primary",
      "options": [
        {"value": "btn--black", "label": "Black"},
        {"value": "btn--white", "label": "White"},
        {"value": "btn--primary", "label": "Primary"},
        {"value": "btn--secondary", "label": "Secondary"}
      ]
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Size",
      "default": "",
      "options": [
        {"value": "btn--small", "label": "Small"},
        {"value": "", "label": "Medium"},
        {"value": "btn--large", "label": "Large"}
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "default": "btn--text",
      "options": [
        {"value": "btn--solid", "label": "Solid"},
        {"value": "btn--outline", "label": "Outline"},
        {"value": "btn--text", "label": "Text"}
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show button arrow",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"},
        {"value": "wrapper--narrow", "label": "Narrow"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading SEO tag",
      "default": "automatic",
      "options": [
        {"value": "automatic", "label": "Automatic"},
        {"value": "h1", "label": "H1"},
        {"value": "h2", "label": "H2"},
        {"value": "h3", "label": "H3"},
        {"value": "h4", "label": "H4"},
        {"value": "h5", "label": "H5"},
        {"value": "h6", "label": "H6"}
      ]
    }
  ],
  "presets": [
    {
      "name": "News",
      "category": "Storytelling"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  }
}
{% endschema %}

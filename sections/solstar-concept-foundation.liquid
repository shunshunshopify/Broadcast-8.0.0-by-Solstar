{%- assign color_scheme = 'color-' | append: section.settings.color_scheme -%}

{%- style -%}
  #SolstarConcept--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="SolstarConcept--{{ section.id }}"
  class="custom-code section-padding {{ section.settings.width }} {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="solstar-concept"
>
  <div
    class="custom-code__inner"
    data-aos="hero"
    data-aos-anchor="#SolstarConcept--{{ section.id }}"
    data-aos-order="1"
  >
    {{ section.settings.code }}
  </div>
</section>

{% render 'solstar-concept-foundation' %}

{% schema %}
{
  "name": "SOLSTAR concept",
  "settings": [
    {
      "type": "liquid",
      "id": "code",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full",
      "options": [
        { "value": "wrapper--full", "label": "Full width" },
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper", "label": "Normal" },
        { "value": "wrapper--narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ]
}
{% endschema %}

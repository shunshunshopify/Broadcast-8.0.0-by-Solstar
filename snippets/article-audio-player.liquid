{% doc %}
Renders an accessible audio player for a blog article.

@param {string} audio_url - The URL of the article audio file.
@param {string} narrator_image_url - The narrator profile image URL.
@param {string} narrator_name - The narrator name.

@example
{% render 'article-audio-player', audio_url: article.metafields.custom.audio_link.value.url, narrator_image_url: 'https://cdn.shopify.com/example.jpg', narrator_name: article.author %}
{% enddoc %}

<article-audio-player-native class="article-audio-player">
  <div class="article-audio-player__identity">
    {%- if narrator_image_url != blank -%}
      <div class="article-audio-player__narrator">
        <img
          src="{{ narrator_image_url | escape }}"
          alt="{{ narrator_name | escape }}"
          width="144"
          height="144"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    <div class="article-audio-player__copy">
      <h2 class="article-audio-player__heading h4">{{ 'blogs.audio.heading' | t }}</h2>
      {%- if narrator_name != blank -%}
        <p class="article-audio-player__narrator-name">
          <span>{{ 'blogs.audio.narrator' | t }}</span>
          <strong>{{ narrator_name }}</strong>
        </p>
        <p class="article-audio-player__narrator-bio">
          10億円規模のECプロジェクトでPMを経験。Shopifyアカデミー3種資格を保持し、元陸上自衛隊（6年）・San Diego State University経済学部卒。趣味はDJで、HiphopとR&amp;Bを中心にプレイしています。
        </p>
      {%- endif -%}
    </div>
  </div>

  <div class="article-audio-player__controls">
    <audio
      class="article-audio-player__native"
      data-audio
      controls
      playsinline
      preload="metadata"
      src="{{ audio_url | escape }}"
    ></audio>

    <span class="article-audio-player__wave" data-wave aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </span>
  </div>
</article-audio-player-native>

{% stylesheet %}
  .article-audio-player {
    display: grid;
    gap: 16px;
    margin: 0 0 32px;
    padding: 24px;
    border-radius: calc(var(--BUTTON-RADIUS, 0px) + 8px);
    background: var(--text-a5);
    color: var(--text);
  }

  .article-audio-player__identity {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .article-audio-player__narrator {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border-radius: 50%;
  }

  .article-audio-player__narrator img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-audio-player__copy {
    min-width: 0;
  }

  .article-audio-player__heading {
    margin: 0;
  }

  .article-audio-player__narrator-name {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 6px 0 0;
    color: var(--text-a70, var(--text));
    font-size: var(--font-body-small);
  }

  .article-audio-player__narrator-name strong {
    color: var(--text);
    font-weight: var(--FONT-WEIGHT-BODY-BOLD, 600);
  }

  .article-audio-player__narrator-bio {
    margin: 8px 0 0;
    color: var(--text-a70, var(--text));
    font-size: var(--font-body-x-small, var(--font-body-small));
    line-height: 1.65;
  }

  .article-audio-player__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  .article-audio-player__native {
    min-width: 0;
    width: 100%;
    accent-color: var(--text);
  }

  .article-audio-player__wave {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 48px;
    gap: 3px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 160ms ease, visibility 0s linear 160ms;
  }

  .article-audio-player__wave i {
    display: block;
    width: 3px;
    height: 10px;
    border-radius: 999px;
    background: #ab8c52;
    transform: scaleY(0.5);
    transform-origin: center;
  }

  .article-audio-player.is-playing .article-audio-player__wave {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  .article-audio-player.is-playing .article-audio-player__wave i {
    animation: article-audio-wave 720ms ease-in-out infinite alternate;
  }

  .article-audio-player.is-playing .article-audio-player__wave i:nth-child(2) {
    animation-delay: -360ms;
  }

  .article-audio-player.is-playing .article-audio-player__wave i:nth-child(3) {
    animation-delay: -180ms;
  }

  .article-audio-player.is-playing .article-audio-player__wave i:nth-child(4) {
    animation-delay: -540ms;
  }

  @keyframes article-audio-wave {
    from { transform: scaleY(0.45); }
    to { transform: scaleY(1.8); }
  }

  @media only screen and (max-width: 749px) {
    .article-audio-player {
      padding: 20px 16px;
    }

    .article-audio-player__identity {
      gap: 14px;
    }

    .article-audio-player__narrator {
      flex-basis: 64px;
      width: 64px;
      height: 64px;
    }

    .article-audio-player__controls {
      gap: 8px;
    }

    .article-audio-player__wave {
      width: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-audio-player.is-playing .article-audio-player__wave i {
      animation: none;
      transform: scaleY(1);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('article-audio-player-native')) {
    customElements.define(
      'article-audio-player-native',
      class ArticleAudioPlayer extends HTMLElement {
        connectedCallback() {
          if (this.isInitialized) return;

          this.isInitialized = true;
          this.audio = this.querySelector('[data-audio]');
          this.handlePlaybackState = () => this.updatePlaybackState();

          this.audio.addEventListener('play', this.handlePlaybackState);
          this.audio.addEventListener('pause', this.handlePlaybackState);
          this.audio.addEventListener('ended', this.handlePlaybackState);
          this.updatePlaybackState();
        }

        disconnectedCallback() {
          this.audio.removeEventListener('play', this.handlePlaybackState);
          this.audio.removeEventListener('pause', this.handlePlaybackState);
          this.audio.removeEventListener('ended', this.handlePlaybackState);
          this.isInitialized = false;
        }

        updatePlaybackState() {
          this.classList.toggle('is-playing', !this.audio.paused && !this.audio.ended);
        }
      }
    );
  }
{% endjavascript %}

    "section_accordion_cream_faq": {
      "type": "section-accordion-group",
      "blocks": {
        "subheading_cream": {
          "type": "subheading",
          "settings": {
            "title": "FAQ"
          }
        },
        "heading_cream": {
          "type": "heading",
          "settings": {
            "title": "よくある質問"
          }
        },
        "question_migrate": {
          "type": "question",
          "settings": {
            "default_open": true,
            "title": "既存のShopifyストアから移行できますか？",
            "content": "<p>はい、移行可能です。既存のShopifyストアの構成や利用中のアプリ、商品データ、デザイン要件を確認したうえで、移行の可否や最適な進め方をご案内します。表示崩れや購入導線への影響を確認しながら移行を進めます。</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "question_apps": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "追加アプリは必要ですか？",
            "content": "<p>Countdown、Wishlist、Shop the look、Before & after、Testimonialsなど、よく使われる販促・回遊・演出機能はCreamに標準搭載しています。そのため、多くの機能は追加アプリなしで利用できます。レビュー、会員制度、配送連携、外部システム連携などは、必要に応じてアプリをご利用ください。</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "question_fonts": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "フォントやブランドカラーは調整できますか？",
            "content": "<p>はい、調整できます。テーマ設定で、タイポグラフィ、カラースキーム、ボタン、バッジ、商品カードなどを調整できます。コードを書かずに、ブランドに合わせたデザインへ変更できます。</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "question_global": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "越境ECにも対応できますか？",
            "content": "<p><br/>はい、対応できます。多言語・多通貨セレクターを搭載しており、Shopify Marketsを活用した越境ECサイトを構築できます。販売する国や地域に応じて、決済方法、配送、翻訳などの設定が別途必要です。<br/><br/></p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        },
        "question_support": {
          "type": "question",
          "settings": {
            "default_open": false,
            "title": "カスタマイズやサポートはどこまで対応していますか？",
            "content": "<p>テーマ設定で対応できる内容、構築時の調整が必要な内容、個別開発が必要な内容を確認したうえで、最適な対応方法をご案内します。サポート内容は、ご利用プランや提供形態によって異なります。</p>",
            "show_icon": false,
            "icon_name": "icon-award",
            "icon_size": 20,
            "icon_color": ""
          }
        }
      },
      "block_order": [
        "subheading_cream",
        "heading_cream",
        "question_migrate",
        "question_apps",
        "question_fonts",
        "question_global",
        "question_support"

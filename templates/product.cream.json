:8px;padding:0;border:0;background:transparent;font-size:.88em;font-style:italic;line-height:1.65;overflow-wrap:anywhere}.cream-setup-tabs__memo{font-weight:700}@media(max-width:374px){.cream-setup-tabs__tab{font-size:11px;padding-inline:4px}}</style><cream-setup-tabs class='cream-setup-tabs'><header class='cream-setup-tabs__head'><p class='cream-setup-tabs__eyebrow'>Setup flow</p><h2>導入方法</h2><p class='cream-setup-tabs__lead'>Shopifyストアの有無にあわせて手順をご確認ください。</p></header><div class='cream-setup-tabs__nav' role='tablist' aria-label='Shopifyストアの状況'><button class='cream-setup-tabs__tab' type='button' role='tab' id='cream-store-tab-{{ block.id }}' aria-controls='cream-store-panel-{{ block.id }}' aria-selected='true'>ストアをお持ちの方</button><button class='cream-setup-tabs__tab' type='button' role='tab' id='cream-no-store-tab-{{ block.id }}' aria-controls='cream-no-store-panel-{{ block.id }}' aria-selected='false' tabindex='-1'>ストアをお持ちでない方</button></div><div class='cream-setup-tabs__panel' id='cream-store-panel-{{ block.id }}' role='tabpanel' aria-labelledby='cream-store-tab-{{ block.id }}' tabindex='0'><ol class='cream-setup-tabs__steps'><li><span>Creamをカートに入れ、無料の購入手続きを進めます。</span></li><li><span>カートの注文メモに、以下の2点をご記入ください。</span><ul class='cream-setup-tabs__details'><li>ShopifyストアURL（例：〇〇.myshopify.com）</li><li>コラボレーターリクエストコード</li></ul></li><li><span>コードはShopify管理画面で確認できます。<small class='cream-setup-tabs__path'>「設定」→「ユーザー」→「セキュリティ」→「コラボレーター」</small></span></li><li><span>SOLSTARから届くコラボレーター申請を承認してください。承認後にCreamをインストールし、完了後にご連絡します。</span></li></ol></div><div class='cream-setup-tabs__panel' id='cream-no-store-panel-{{ block.id }}' role='tabpanel' aria-labelledby='cream-no-store-tab-{{ block.id }}' tabindex='0' hidden><ol class='cream-setup-tabs__steps'><li><span>Creamをカートに入れ、無料の購入手続きを進めます。</span></li><li><span>カートの注文メモに、<span class='cream-setup-tabs__memo'>「Shopifyストアを持っていません」</span>とご記入ください。</span></li><li><span>SOLSTARがストア開設からCreamの導入までご案内します。Creamをインストールした状態でお渡しすることも可能です。</span></li></ol></div></cream-setup-tabs><script>if(!customElements.get('cream-setup-tabs')){class CreamSetupTabs extends HTMLElement{connectedCallback(){if(this.dataset.ready)return;this.dataset.ready='true';this.tabs=Array.from(this.querySelectorAll('[role=tab]'));this.panels=Array.from(this.querySelectorAll('[role=tabpanel]'));this.tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>this.select(index));tab.addEventListener('keydown',event=>{let next;if(event.key==='ArrowRight'||event.key==='ArrowDown')next=(index+1)%this.tabs.length;if(event.key==='ArrowLeft'||event.key==='ArrowUp')next=(index-1+this.tabs.length)%this.tabs.length;if(event.key==='Home')next=0;if(event.key==='End')next=this.tabs.length-1;if(next===undefined)return;event.preventDefault();this.select(next);this.tabs[next].focus()})})}select(index){this.tabs.forEach((tab,tabIndex)=>{const selected=tabIndex===index;tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;this.panels[tabIndex].hidden=!selected})}}customElements.define('cream-setup-tabs',CreamSetupTabs)}</script>",

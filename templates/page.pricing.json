    "section_custom_code_G4hPhT": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n/* ===========================\n   SOLSTAR – Basic Plan (Isolated)\n   ※ solstar-express と干渉しないように完全別prefix\n   =========================== */\n.solstar-basic {\n  /* scheme-10 */\n  --sb-text: #fcfbf9;          /* section_text */\n  --sb-bg: #0d0326;            /* section_bg */\n  --sb-card: #f5f2ec;          /* section_bg_light */\n  --sb-line: #d1cdc4;          /* lines_and_border */\n  --sb-accent: #665035;\n  --sb-link: #ffffff;\n\n  color: var(--sb-text);\n  background: var(--sb-bg);\n  padding: 0px 16px;\n}\n\n.solstar-basic__inner {\n  max-width: 1020px;\n  margin: 0 auto;\n}\n\n/* Header */\n.solstar-basic__header {\n  margin-bottom: 18px;\n}\n\n.solstar-basic__title {\n  font-size: 36px;\n  line-height: 1.15;\n  font-weight: 900;\n  margin: 0 0 10px;\n  color: var(--sb-text);\n}\n\n.solstar-basic__sub {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.9;\n  font-weight: 900;\n  color: var(--sb-text);\n}\n\n/* Layout */\n.solstar-basic__layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin-top: 18px;\n  align-items: stretch;\n}\n\n/* Card */\n.solstar-basic-card {\n  background: var(--sb-card);\n  border: 1px solid var(--sb-line);\n  border-radius: 16px;\n  padding: 18px;\n  min-width: 0;\n  color: #111111;\n}\n\n.solstar-basic-card__title {\n  margin: 0 0 14px;\n  font-size: 16px;\n  font-weight: 900;\n  line-height: 1.35;\n  color: #111111;\n}\n\n/* ===== Table ===== */\n.solstar-basic-table-wrap {\n  border: none;\n  border-radius: 14px;\n  overflow: hidden;\n  background: transparent;\n}\n\n.solstar-basic-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border: 1px solid var(--sb-line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--sb-card);\n  color: #111111;\n}\n\n.solstar-basic-table th,\n.solstar-basic-table td {\n  padding: 12px 14px;\n  border-top: 1px solid var(--sb-line);\n  vertical-align: middle;\n  text-align: left;\n  color: #111111;\n}\n\n.solstar-basic-table tr:first-child th,\n.solstar-basic-table tr:first-child td {\n  border-top: none;\n}\n\n.solstar-basic-table th {\n  width: 34%;\n  font-size: 12px;\n  font-weight: 700;\n  white-space: nowrap;\n  border-right: 1px solid var(--sb-line);\n  background: rgba(120, 120, 120, 0.14);\n}\n\n.solstar-basic-table td {\n  font-size: 14px;\n  line-height: 1.7;\n  word-break: break-word;\n}\n\n/* ===========================\n   ★ 構築内容のみ 長文Wrap対応\n   =========================== */\n.solstar-basic-scope .solstar-basic-table th,\n.solstar-basic-scope .solstar-basic-table td {\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n/* ===== Lists ===== */\n.solstar-basic-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 1.2em;\n  color: #111111;\n}\n\n.solstar-basic-list li {\n  margin-top: 6px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n.solstar-basic-list li:first-child {\n  margin-top: 0;\n}\n\n/* Bullet OFF (only inside tables) */\n.solstar-basic-table .solstar-basic-list {\n  list-style: none;\n  padding-left: 0;\n  margin-left: 0;\n}\n.solstar-basic-table .solstar-basic-list li {\n  margin-left: 0;\n}\n\n/* Link（保険） */\n.solstar-basic a {\n  color: var(--sb-link);\n}\n\n/* Desktop */\n@media (min-width: 860px) {\n  .solstar-basic {\n    padding: 0px 24px;\n  }\n\n  .solstar-basic__layout {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .solstar-basic-service { grid-column: 1; grid-row: 1; }\n  .solstar-basic-scope   { grid-column: 2; grid-row: 1; }\n  .solstar-basic-client  { grid-column: 1; grid-row: 2; }\n  .solstar-basic-paid    { grid-column: 2; grid-row: 2; }\n  .solstar-basic-nosup   { grid-column: 1; grid-row: 3; }\n\n  .solstar-basic-table th {\n    width: 32%;\n  }\n}\n\n/* Small screens */\n@media (max-width: 420px) {\n  .solstar-basic-table th {\n    width: 38%;\n    white-space: normal;\n  }\n}\n\n</style>\n\n<section class=\"solstar-basic\">\n  <div class=\"solstar-basic__inner\">\n    <header class=\"solstar-basic__header\">\n      <h2 class=\"solstar-basic__title\">Basicプラン</h2>\n      <p class=\"solstar-basic__sub\">小規模・少数SKUで、ブランドの世界観を育てながら運用したい方へ</p>\n    </header>\n\n    <div class=\"solstar-basic__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-basic-card solstar-basic-service\">\n        <h3 class=\"solstar-basic-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <tbody>\n              <tr><th>納期</th><td>約4〜8週間</td></tr>\n              <tr><th>価格</th><td>1,100,000円（税込）〜</td></tr>\n              <tr><th>体制</th><td>ディレクター1名＋エンジニア1名</td></tr>\n              <tr><th>対象</th><td>少人数体制で、自社ECをこれから本格運用していきたい方</td></tr>\n              <tr>\n                <th>進捗打合せ回数</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>3回（要件・構築内容・公開前の確認）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>納品物</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>構築済み御社ECストア</li>\n                    <li>管理画面・テーマ権限一式</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>修正・変更ルール</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>3回まで</li>\n                    <li>※大幅変更は別途お見積り</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 構築内容 -->\n      <section class=\"solstar-basic-card solstar-basic-scope\">\n        <h3 class=\"solstar-basic-card__title\">構築内容</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <tbody>\n              <tr><th>コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th>要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr>\n                <th>ECサイトセットアップ</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>基本情報・ページ設定</li>\n                    <li>決済／配送／税設定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th>サイトデザイン制作</th><td>各ページのデザイン調整</td></tr>\n\n              <tr>\n                <th>各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>商品登録（20点）</li>\n                    <li>カテゴリー登録（6点）</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr><th>アプリ連携</th><td>3点</td></tr>\n              <tr><th>オリジナルページ制作</th><td>3ページ</td></tr>\n              <tr><th>テスト・公開</th><td>購入テスト・表示確認（PC / Mobile）</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-basic-card solstar-basic-client\">\n        <h3 class=\"solstar-basic-card__title\">お客様にご対応いただくこと</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <tbody>\n              <tr><th>素材・ドメイン準備</th><td>キービジュアル、商品情報、画像素材および、ドメインのご準備</td></tr>\n              <tr><th>コンテンツ提供</th><td>コンテンツ原稿のご用意</td></tr>\n              <tr><th>ECサイト運用</th><td>ECサイト納品後の運用・更新</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 別途有料対応 -->\n      <section class=\"solstar-basic-card solstar-basic-paid\">\n        <h3 class=\"solstar-basic-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-basic-list\">\n          <li>保守運用サポート</li>\n          <li>追加アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>バナー画像制作</li>\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>POS連携</li>\n        </ul>\n      </section>\n\n      <!-- 対応不可 -->\n      <section class=\"solstar-basic-card solstar-basic-nosup\">\n        <h3 class=\"solstar-basic-card__title\">対応不可</h3>\n        <ul class=\"solstar-basic-list\">\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",

    "section_custom_code_kkwVXf": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n/* ===========================\n   SOLSTAR – Solstar Express\n   Clean / Table統合・枠干渉解消\n   =========================== */\n.solstar-express {\n  /* scheme-10 */\n  --text: #fcfbf9;            /* section_text */\n  --bg: #0d0326;              /* section_bg */\n  --card: #f5f2ec;            /* section_bg_light */\n  --line: #d1cdc4;            /* lines_and_border */\n  --accent: #665035;\n  --link: #ffffff;\n\n  --btn-primary-bg: #144e94;\n  --btn-primary-text: #fcfbf9;\n  --btn-primary-border: #fcfbf9;\n\n  --btn-secondary-bg: #787878;\n  --btn-secondary-text: #fcfbf9;\n  --btn-secondary-border: #fcfbf9;\n\n  --overlay: #000000;\n\n  color: var(--text);\n  background: var(--bg);\n  padding: 0px 16px;\n}\n\n.solstar-express__inner {\n  max-width: 1020px;\n  margin: 0 auto;\n}\n\n/* Header */\n.solstar-express__header {\n  margin-bottom: 18px;\n}\n\n/* ===== Title + Badge ===== */\n.solstar-express__title-wrap {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\n.solstar-express__title {\n  font-size: 36px;\n  line-height: 1.15;\n  font-weight: 900;\n  margin: 0;\n  color: var(--text);\n}\n\n/* Badge（おすすめ） */\n.solstar-express__badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 9px 14px;\n  font-size: 14px;\n  font-weight: 900;\n  line-height: 1;\n  color: var(--btn-primary-text);\n  background: #AB8C52; /* ★指定カラー */\n  border-radius: 999px;\n  letter-spacing: 0.02em;\n}\n\n.solstar-express__sub {\n  margin: 10px 0 0;\n  font-size: 15px;\n  line-height: 1.9;\n  font-weight: 900;\n  color: var(--text);\n}\n\n/* ===== Mobile: Badgeをタイトルの上に ===== */\n@media (max-width: 420px) {\n  .solstar-express__title-wrap {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 10px;\n  }\n  .solstar-express__badge {\n    order: -1;\n  }\n}\n\n/* Layout */\n.solstar-express__layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin-top: 18px;\n  align-items: stretch;\n}\n\n/* Card */\n.solstar-card {\n  background: var(--card);\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  padding: 18px;\n  min-width: 0;\n  color: #111111;\n}\n\n.solstar-card__title {\n  margin: 0 0 14px;\n  font-size: 16px;\n  font-weight: 900;\n  line-height: 1.35;\n  color: #111111;\n}\n\n/* ===== Table ===== */\n.solstar-table-wrap {\n  border: none;\n  border-radius: 14px;\n  overflow: hidden;\n  background: transparent;\n}\n\n.solstar-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--card);\n  color: #111111;\n}\n\n.solstar-table th,\n.solstar-table td {\n  padding: 12px 14px;\n  border-top: 1px solid var(--line);\n  vertical-align: middle;\n  text-align: left;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n  color: #111111;\n}\n\n.solstar-table tr:first-child th,\n.solstar-table tr:first-child td {\n  border-top: none;\n}\n\n.solstar-table th {\n  width: 34%;\n  font-size: 12px;\n  font-weight: 700;\n  border-right: 1px solid var(--line);\n  background: rgba(120, 120, 120, 0.14);\n}\n\n.solstar-table td {\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n/* ===== Table inner list ===== */\n.solstar-table-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 1.2em;\n  color: #111111;\n}\n\n.solstar-table-list li {\n  margin-top: 6px;\n  font-size: 14px;\n  line-height: 1.7;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n.solstar-table-list li:first-child {\n  margin-top: 0;\n}\n\n/* ===== Bullet OFF (only specific tables) ===== */\n.solstar-service .solstar-table-list,\n.solstar-initial .solstar-table-list {\n  list-style: none;\n  padding-left: 0;\n  margin-left: 0;\n}\n\n/* Fee inline */\n.solstar-fee-inline {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n  min-width: 0;\n}\n\n.solstar-fee-note {\n  font-size: 12px;\n  line-height: 1.6;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  color: rgba(17, 17, 17, 0.75);\n}\n\n/* Link */\n.solstar-express a {\n  color: var(--link);\n}\n\n/* Desktop */\n@media (min-width: 860px) {\n  .solstar-express {\n    padding: 0px 24px;\n  }\n\n  .solstar-express__layout {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .solstar-service { grid-column: 1; grid-row: 1; }\n  .solstar-initial { grid-column: 2; grid-row: 1; }\n  .solstar-monthly { grid-column: 1; grid-row: 2; }\n  .solstar-client  { grid-column: 2; grid-row: 2; }\n  .solstar-paid    { grid-column: 1; grid-row: 3; }\n  .solstar-nosupport { grid-column: 2; grid-row: 3; }\n\n  .solstar-table th {\n    width: 32%;\n  }\n}\n\n</style>\n\n<section class=\"solstar-express\">\n  <div class=\"solstar-express__inner\">\n    <header class=\"solstar-express__header\">\n      <!-- 見出し + おすすめバッジ -->\n      <div class=\"solstar-express__title-wrap\">\n        <h2 class=\"solstar-express__title\">SOLSTAR EXPRESS</h2>\n        <span class=\"solstar-express__badge\">おすすめ</span>\n      </div>\n\n      <p class=\"solstar-express__sub\">\n        EC担当者を採用する前に、外部EC事業部として活用したいメーカー様へ\n      </p>\n    </header>\n\n    <div class=\"solstar-express__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-card solstar-service\">\n        <h3 class=\"solstar-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <tbody>\n              <tr><th>納期目安</th><td>約2〜4週間</td></tr>\n              <tr>\n                <th>料金</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>初期費用：55,000円（税込）</li>\n                    <li>月額36,500円（税込）\n〜</li>\n           \n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>SOLSTAR販売運営分</th>\n                <td>\n                  <span class=\"solstar-fee-inline\">\n                    <span>販売価格の最大20%</span>\n                  </span>\n                </td>\n              </tr>\n              <tr><th>メーカー様受取分</th><td>販売価格の80%以上</td></tr>\n              <tr><th>精算</th><td>月末締め・翌月に商品仕入代金としてお支払い</td></tr>\n              <tr><th>販売形態</th><td>購入者から見た販売者はSOLSTAR。メーカー様はSOLSTARへ商品を供給・発送</td></tr>\n              <tr><th>対象</th><td>商品はあるが、ECサイト制作・運用・販売管理にリソースを割けないメーカー様</td></tr>\n              <tr><th>契約期間</th><td>6〜12ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 初期費用に含まれる内容 -->\n      <section class=\"solstar-card solstar-initial\">\n        <h3 class=\"solstar-card__title\">初期費用に含まれる内容</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <tbody>\n              <tr><th>コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th>要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr>\n                <th>ECサイトセットアップ</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>基本情報・ページ設定</li>\n                    <li>決済／配送／税設定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th>サイトデザイン制作</th><td>各ページのデザイン調整</td></tr>\n              <tr>\n                <th>各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>商品登録（5点）</li>\n                    <li>カテゴリー登録（3点）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th>LP制作（1ページ）</th><td>構成設計／デザイン反映／CTA設計</td></tr>\n              <tr>\n                <th>テスト・公開</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>購入テスト・表示確認（PC / Mobile）</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 月々のECサイト運用内容 -->\n      <section class=\"solstar-card solstar-monthly\">\n        <h3 class=\"solstar-card__title\">月々のECサイト運用内容</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <tbody>\n              <tr>\n                <th>商品登録</th>\n                <td>月5点まで。商品登録・更新に対応</td>\n              </tr>\n              <tr>\n                <th>サイトデザイン修正</th>\n                <td>月5回まで。バナー差し替えや文言調整などの軽微な修正</td>\n              </tr>\n              <tr>\n                <th>ECサイトの不具合対応</th>\n                <td>表示崩れや動作不具合など対応</td>\n              </tr>\n              <tr>\n                <th>購入者対応の一次窓口</th>\n                <td>購入者からのお問い合わせ・発送通知など、購入者対応の一次窓口をSOLSTARが担当</td>\n              </tr>\n              <tr>\n                <th>販売データの共有・改善提案</th>\n                <td>月次レポートで販売実績を共有し、商品ページ・訴求・キャンペーンの改善を提案</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-card solstar-client\">\n        <h3 class=\"solstar-card__title\">メーカー様にご対応いただくこと</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <tbody>\n              <tr>\n                <th>商品情報・素材の提供</th>\n                <td>商品情報、画像素材、スペックのご提供</td>\n              </tr>\n              <tr>\n                <th>在庫管理</th>\n                <td>商品在庫の管理</td>\n              </tr>\n              <tr>\n                <th>商品の発送</th>\n                <td>注文情報をもとに、購入者へ商品を発送</td>\n              </tr>\n              <tr>\n                <th>追跡番号の共有</th>\n                <td>発送後、追跡番号をSOLSTARへ共有</td>\n              </tr>\n              <tr>\n                <th>商品専門の問い合わせ協力</th>\n                <td>商品専門知識が必要な問い合わせや、商品不良・誤配送などメーカー様起因の対応にご協力</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section class=\"solstar-card solstar-paid\">\n        <h3 class=\"solstar-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-table-list\">\n          <li>アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>バナー画像制作</li>\n          <li>独自機能開発</li>\n          <li>POS連携</li>\n        </ul>\n      </section>\n\n      <section class=\"solstar-card solstar-nosupport\">\n        <h3 class=\"solstar-card__title\">対応不可</h3>\n        <ul class=\"solstar-table-list\">\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n  </div>\n</section>",

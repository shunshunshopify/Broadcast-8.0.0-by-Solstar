    "section_custom_code_jsonld_pricing": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Organization\",\n      \"@id\": \"{{ shop.url }}#organization\",\n      \"name\": \"株式会社SOLSTAR\",\n      \"alternateName\": \"SOLSTAR\",\n      \"url\": \"{{ shop.url }}\",\n      \"description\": \"Shopifyを専門に、ブランドの成長フェーズに合わせたECサイトの構築・運営を支援する会社です。\",\n      \"knowsAbout\": [\n        \"Shopify開発\",\n        \"Shopifyストア運営\",\n        \"Shopify B2B\"\n      ],\n      \"hasCredential\": [\n        {\n          \"@type\": \"EducationalOccupationalCredential\",\n          \"name\": \"Shopifyパートナー認定\"\n        },\n        {\n          \"@type\": \"EducationalOccupationalCredential\",\n          \"name\": \"Shopifyアカデミー認定資格（開発）\"\n        },\n        {\n          \"@type\": \"EducationalOccupationalCredential\",\n          \"name\": \"Shopifyアカデミー認定資格（運営）\"\n        },\n        {\n          \"@type\": \"EducationalOccupationalCredential\",\n          \"name\": \"Shopifyアカデミー認定資格（B2B）\"\n        }\n      ],\n      \"sameAs\": [\n        \"https://www.instagram.com/solstar_official\",\n        \"https://www.youtube.com/@solstar-official\"\n      ]\n    },\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"{{ shop.url }}#website\",\n      \"url\": \"{{ shop.url }}\",\n      \"name\": \"株式会社SOLSTAR\",\n      \"publisher\": {\n        \"@id\": \"{{ shop.url }}#organization\"\n      },\n      \"inLanguage\": \"ja\"\n    },\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"{{ canonical_url }}#webpage\",\n      \"url\": \"{{ canonical_url }}\",\n      \"name\": \"料金プラン｜Shopify ECサイト構築・制作・保守運用｜株式会社SOLSTAR\",\n      \"description\": \"SOLSTARのShopify ECサイト構築・制作プラン（SOLSTAR EXPRESS／Basic／Standard）と、保守運用プラン（Store Care／Growth Partner／Growth OS）の料金・対応内容をご案内します。\",\n      \"isPartOf\": {\n        \"@id\": \"{{ shop.url }}#website\"\n      },\n      \"about\": [\n        {\n          \"@id\": \"{{ canonical_url }}#service-build\"\n        },\n        {\n          \"@id\": \"{{ canonical_url }}#service-maintenance\"\n        }\n      ],\n      \"mainEntity\": [\n        {\n          \"@id\": \"{{ canonical_url }}#service-build\"\n        },\n        {\n          \"@id\": \"{{ canonical_url }}#service-maintenance\"\n        },\n        {\n          \"@id\": \"{{ canonical_url }}#faq\"\n        }\n      ],\n      \"breadcrumb\": {\n        \"@id\": \"{{ canonical_url }}#breadcrumb\"\n      },\n      \"inLanguage\": \"ja\"\n    },\n    {\n      \"@type\": \"Service\",\n      \"@id\": \"{{ canonical_url }}#service-build\",\n      \"name\": \"Shopify ECサイト構築・制作\",\n      \"serviceType\": \"Shopify ECサイト構築・制作\",\n      \"category\": \"ECサイト構築サービス\",\n      \"url\": \"{{ canonical_url }}\",\n      \"provider\": {\n        \"@id\": \"{{ shop.url }}#organization\"\n      },\n      \"areaServed\": {\n        \"@type\": \"Country\",\n        \"name\": \"日本\"\n      },\n      \"description\": \"Shopifyを活用したECサイトの構築・制作サービス。事業規模や移行要件に応じて、SOLSTAR EXPRESS、Basic、Standardの各プランをご用意しています。\",\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"ECサイト構築・制作プラン\",\n        \"itemListElement\": [\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-solstar-express\",\n            \"name\": \"SOLSTAR EXPRESS\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"36500\",\n            \"description\": \"ECサイト制作・運用・販売管理を外部EC事業部として支援するメーカー向けプラン。初期費用55,000円（税込）、月額36,500円（税込）〜です。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"priceSpecification\": [\n              {\n                \"@type\": \"UnitPriceSpecification\",\n                \"name\": \"月額料金\",\n                \"price\": \"36500\",\n                \"priceCurrency\": \"JPY\",\n                \"unitText\": \"MONTH\",\n                \"billingDuration\": \"P1M\"\n              },\n              {\n                \"@type\": \"PriceSpecification\",\n                \"name\": \"初期費用\",\n                \"price\": \"55000\",\n                \"priceCurrency\": \"JPY\"\n              }\n            ],\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"契約期間\",\n                \"value\": \"6〜12ヶ月\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"SOLSTAR販売運営分\",\n                \"value\": \"販売価格の最大20%\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"メーカー様受取分\",\n                \"value\": \"販売価格の80%以上\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-basic\",\n            \"name\": \"Basicプラン\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"1100000\",\n            \"description\": \"小規模・少数SKUで、ブランドの世界観を育てながら運用したい方向けのShopify ECサイト構築プラン。価格は1,100,000円（税込）〜です。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"価格表記\",\n                \"value\": \"1,100,000円（税込）〜\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"納期\",\n                \"value\": \"約4〜8週間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"体制\",\n                \"value\": \"ディレクター1名＋エンジニア1名\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"進捗打合せ回数\",\n                \"value\": \"3回\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"修正・変更ルール\",\n                \"value\": \"3回まで（大幅変更は別途お見積り）\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-standard\",\n            \"name\": \"Standardプラン\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"2200000\",\n            \"description\": \"BASE・STORESなどから次の成長基盤へ移行し、ブランド表現・CRM・運用効率を整えたいD2Cブランド向けのリニューアル・移行プラン。価格は2,200,000円（税込）〜です。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"価格表記\",\n                \"value\": \"2,200,000円（税込）〜\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"納期目安\",\n                \"value\": \"約8〜12週間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"体制\",\n                \"value\": \"ディレクター1名＋エンジニア2名\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"進捗打合せ回数\",\n                \"value\": \"5回\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"修正・変更ルール\",\n                \"value\": \"3回まで（大幅変更は別途お見積り）\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"@type\": \"Service\",\n      \"@id\": \"{{ canonical_url }}#service-maintenance\",\n      \"name\": \"Shopify 保守運用・グロース支援\",\n      \"serviceType\": \"Shopify 保守運用・運用改善\",\n      \"category\": \"ECサイト保守運用サービス\",\n      \"url\": \"{{ canonical_url }}\",\n      \"provider\": {\n        \"@id\": \"{{ shop.url }}#organization\"\n      },\n      \"areaServed\": {\n        \"@type\": \"Country\",\n        \"name\": \"日本\"\n      },\n      \"description\": \"Shopify専門の知見をもとに、サイト保守から運用改善、EC戦略を含めた伴走支援まで対応する保守運用サービス。Store Care／Growth Partner／Growth OSの3プランをご用意しています。\",\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"保守運用プラン\",\n        \"itemListElement\": [\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-store-care\",\n            \"name\": \"Store Care\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"22000\",\n            \"description\": \"Shopifyやサイト運営の相談に回答し、課題に応じた改善案や施策をご案内するアドバイザリープラン。日々の運用・実装は自社で行い、必要なときに専門家へ相談したい企業に適しています。月額22,000円（税込）。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"eligibleDuration\": {\n              \"@type\": \"QuantitativeValue\",\n              \"value\": 3,\n              \"unitText\": \"MONTH\"\n            },\n            \"priceSpecification\": [\n              {\n                \"@type\": \"UnitPriceSpecification\",\n                \"name\": \"月額料金\",\n                \"price\": \"22000\",\n                \"priceCurrency\": \"JPY\",\n                \"unitText\": \"MONTH\",\n                \"billingDuration\": \"P1M\"\n              }\n            ],\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"月間対応工数\",\n                \"value\": \"2時間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"最低契約期間\",\n                \"value\": \"3ヶ月\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-growth-partner\",\n            \"name\": \"Growth Partner\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"110000\",\n            \"description\": \"サイト管理と改善提案・実装支援を行う運用改善プラン。月額110,000円（税込）。サイト改善提案、デザイン修正、商品登録、月1回の定例MTGを行い、月間対応工数の範囲内で実装まで支援します。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"eligibleDuration\": {\n              \"@type\": \"QuantitativeValue\",\n              \"value\": 3,\n              \"unitText\": \"MONTH\"\n            },\n            \"priceSpecification\": [\n              {\n                \"@type\": \"UnitPriceSpecification\",\n                \"name\": \"月額料金\",\n                \"price\": \"110000\",\n                \"priceCurrency\": \"JPY\",\n                \"unitText\": \"MONTH\",\n                \"billingDuration\": \"P1M\"\n              }\n            ],\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"月間対応工数\",\n                \"value\": \"10時間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"最低契約期間\",\n                \"value\": \"3ヶ月\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"{{ canonical_url }}#offer-growth-os\",\n            \"name\": \"Growth OS\",\n            \"url\": \"{{ canonical_url }}\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"330000\",\n            \"description\": \"EC戦略から改善施策の実行まで伴走する上位プラン。月額330,000円（税込）。売上やCVR、客単価などをもとに改善優先順位や月次ロードマップ設計に深く入り、施策提案・実装・検証まで支援します。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"eligibleDuration\": {\n              \"@type\": \"QuantitativeValue\",\n              \"value\": 3,\n              \"unitText\": \"MONTH\"\n            },\n            \"priceSpecification\": [\n              {\n                \"@type\": \"UnitPriceSpecification\",\n                \"name\": \"月額料金\",\n                \"price\": \"330000\",\n                \"priceCurrency\": \"JPY\",\n                \"unitText\": \"MONTH\",\n                \"billingDuration\": \"P1M\"\n              }\n            ],\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"月間対応工数\",\n                \"value\": \"30時間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"最低契約期間\",\n                \"value\": \"3ヶ月\"\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"@id\": \"{{ canonical_url }}#breadcrumb\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"ホーム\",\n          \"item\": \"{{ shop.url }}\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"料金\",\n          \"item\": \"{{ canonical_url }}\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"@id\": \"{{ canonical_url }}#faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"どのプランを選べばよいですか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"相談や改善施策の案内を中心に受けたい場合はStore Care、サイト更新や商品登録などの実装支援まで必要な場合はGrowth Partner、データ分析や戦略設計から実行まで伴走してほしい場合はGrowth OSが適しています。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Store Careにサイトの修正作業は含まれますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"含まれません。Store CareはShopifyやサイト運営に関する相談への回答、サイト改善案、施策のご案内を行うアドバイザリープランです。修正や実装が必要な場合は、Growth Partner以上をご検討ください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"最低契約期間は何ヶ月ですか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Store Care、Growth Partner、Growth OSのいずれも最低契約期間は3ヶ月です。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"月間対応工数を超えた場合はどうなりますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"事前に作業内容と追加工数をご相談し、必要に応じて11,000円（税込）/ 時間で追加対応します。未消化の対応工数は原則として翌月へ繰り越しできません。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"広告運用やSNS運用、記事・画像・動画制作も依頼できますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Growth PartnerとGrowth OSでは対応可能ですが、月額プランには含まれません。広告運用、SNS運用、記事制作、動画制作、画像制作は内容を確認のうえ別途お見積もりします。Store Careでは対応対象外です。\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>",

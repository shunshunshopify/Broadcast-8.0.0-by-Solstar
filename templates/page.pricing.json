    "section_custom_code_Mn7Tcp": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n/* ===========================\n   SOLSTAR – 保守運用プラン (Maintenance / Isolated)\n   ※ express / basic / standard / pro と干渉しない完全別prefix\n   =========================== */\n.solstar-maint {\n  /* scheme-10 */\n  --sm-text: #fcfbf9;          /* section_text */\n  --sm-bg: #0d0326;            /* section_bg */\n  --sm-card: #f5f2ec;          /* section_bg_light */\n  --sm-line: #d1cdc4;          /* lines_and_border */\n  --sm-accent: #665035;\n  --sm-link: #ffffff;\n\n  color: var(--sm-text);\n  background: var(--sm-bg);\n  padding: 0px 16px;\n}\n\n.solstar-maint__inner {\n  max-width: 1020px;\n  margin: 0 auto;\n}\n\n/* Header */\n.solstar-maint__header {\n  margin-bottom: 18px;\n}\n\n.solstar-maint__title {\n  font-size: 36px;\n  line-height: 1.15;\n  font-weight: 900;\n  margin: 0 0 10px;\n  color: var(--sm-text);\n}\n\n.solstar-maint__sub {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.9;\n  font-weight: 900;\n  color: var(--sm-text);\n}\n\n/* Layout */\n.solstar-maint__layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin-top: 18px;\n  align-items: stretch;\n}\n\n/* Card */\n.solstar-maint-card {\n  background: var(--sm-card);\n  border: 1px solid var(--sm-line);\n  border-radius: 16px;\n  padding: 18px;\n  min-width: 0;\n  color: #111111;\n}\n\n.solstar-maint-card__head {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin: 0 0 10px;\n}\n\n.solstar-maint-card__title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 900;\n  line-height: 1.3;\n  color: #111111;\n}\n\n.solstar-maint-card__price {\n  margin: 0 0 10px;\n  font-size: 22px;\n  font-weight: 900;\n  line-height: 1.2;\n  color: #111111;\n}\n\n.solstar-maint-card__price small {\n  font-size: 13px;\n  font-weight: 700;\n  color: rgba(17, 17, 17, 0.7);\n}\n\n.solstar-maint-card__desc {\n  margin: 0 0 12px;\n  font-size: 13px;\n  line-height: 1.8;\n  color: #333333;\n}\n\n/* Badge（おすすめ） */\n.solstar-maint-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 6px 12px;\n  font-size: 12px;\n  font-weight: 900;\n  line-height: 1;\n  color: #fcfbf9;\n  background: #AB8C52;\n  border-radius: 999px;\n  letter-spacing: 0.02em;\n}\n\n/* ===== Table（プラン詳細） ===== */\n.solstar-maint-table-wrap {\n  border: none;\n  border-radius: 14px;\n  overflow: hidden;\n  background: transparent;\n}\n\n.solstar-maint-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border: 1px solid var(--sm-line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--sm-card);\n  color: #111111;\n}\n\n.solstar-maint-table th,\n.solstar-maint-table td {\n  padding: 12px 14px;\n  border-top: 1px solid var(--sm-line);\n  vertical-align: middle;\n  text-align: left;\n  color: #111111;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n.solstar-maint-table tr:first-child th,\n.solstar-maint-table tr:first-child td {\n  border-top: none;\n}\n\n.solstar-maint-table th {\n  width: 42%;\n  font-size: 12px;\n  font-weight: 700;\n  border-right: 1px solid var(--sm-line);\n  background: rgba(120, 120, 120, 0.14);\n}\n\n.solstar-maint-table td {\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n/* ===== Lists ===== */\n.solstar-maint-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 1.2em;\n  color: #111111;\n}\n\n.solstar-maint-list li {\n  margin-top: 6px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n.solstar-maint-list li:first-child {\n  margin-top: 0;\n}\n\n.solstar-maint-text {\n  margin: 0 0 10px;\n  font-size: 14px;\n  line-height: 1.8;\n  color: #111111;\n}\n.solstar-maint-text:last-child {\n  margin-bottom: 0;\n}\n\n/* ===== 比較表（全幅・モバイル横スクロール） ===== */\n.solstar-maint-compare {\n  grid-column: 1 / -1;\n}\n\n.solstar-maint-compare__scroll {\n  width: 100%;\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n  border-radius: 14px;\n}\n\n.solstar-compare-table {\n  width: 100%;\n  min-width: 680px;\n  border-collapse: collapse;\n  border: 1px solid var(--sm-line);\n  background: var(--sm-card);\n  color: #111111;\n}\n\n.solstar-compare-table th,\n.solstar-compare-table td {\n  padding: 10px 12px;\n  border-top: 1px solid var(--sm-line);\n  border-right: 1px solid var(--sm-line);\n  text-align: center;\n  font-size: 13px;\n  line-height: 1.6;\n  color: #111111;\n  vertical-align: middle;\n}\n\n.solstar-compare-table th:last-child,\n.solstar-compare-table td:last-child {\n  border-right: none;\n}\n\n.solstar-compare-table tbody tr:first-child th,\n.solstar-compare-table tbody tr:first-child td {\n  border-top: none;\n}\n\n.solstar-compare-table thead th {\n  background: rgba(120, 120, 120, 0.18);\n  font-size: 13px;\n  font-weight: 900;\n  border-top: none;\n}\n\n.solstar-compare-table tbody th {\n  text-align: left;\n  font-weight: 700;\n  font-size: 13px;\n  background: rgba(120, 120, 120, 0.08);\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n.solstar-mark-yes {\n  color: #1f7a3d;\n  font-weight: 900;\n}\n.solstar-mark-paid {\n  font-size: 12px;\n  color: #9a6a1c;\n  font-weight: 700;\n}\n.solstar-mark-no {\n  color: rgba(17, 17, 17, 0.45);\n}\n\n/* notes full width */\n.solstar-maint-note {\n  grid-column: 1 / -1;\n}\n\n/* Link */\n.solstar-maint a {\n  color: var(--sm-link);\n}\n\n/* Desktop */\n@media (min-width: 860px) {\n  .solstar-maint {\n    padding: 0px 24px;\n  }\n\n  .solstar-maint__layout {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .solstar-maint-table th {\n    width: 40%;\n  }\n}\n\n/* Small screens */\n@media (max-width: 420px) {\n  .solstar-maint-table th {\n    width: 44%;\n  }\n}\n</style>\n\n<section class=\"solstar-maint\">\n  <div class=\"solstar-maint__inner\">\n    <header class=\"solstar-maint__header\">\n      <h2 class=\"solstar-maint__title\">保守運用プラン</h2>\n      <p class=\"solstar-maint__sub\">Shopify専門の知見をもとに、サイト保守から運用改善、EC戦略を含めた伴走支援まで、目的に応じた3つの保守運用プランをご用意しています。</p>\n    </header>\n\n    <div class=\"solstar-maint__layout\">\n      <!-- Store Care -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Store Care</h3>\n        </div>\n        <p class=\"solstar-maint-card__price\">22,000円<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">保守・軽微更新を中心とした基本プラン。自社で日々の運用を行いながら、表示崩れや軽微な修正、商品登録などを必要に応じて依頼したい企業に適しています。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <tbody>\n              <tr><th>月間対応工数</th><td>2時間</td></tr>\n              <tr><th>主な目的</th><td>保守・軽微更新</td></tr>\n              <tr><th>対象</th><td>自社運用を基本に、最低限の保守・軽微更新を任せたい企業</td></tr>\n              <tr><th>最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- Growth Partner -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Growth Partner</h3>\n          <span class=\"solstar-maint-badge\">おすすめ</span>\n        </div>\n        <p class=\"solstar-maint-card__price\">110,000円<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">サイト管理と月次改善提案を行う運用改善プラン。SOLSTARがサイト管理、SEO・表示速度改善、月次レポート、改善施策提案を行い、月間対応工数の範囲内で実装まで支援します。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <tbody>\n              <tr><th>月間対応工数</th><td>10時間</td></tr>\n              <tr><th>主な目的</th><td>サイト管理＋改善提案</td></tr>\n              <tr><th>対象</th><td>社内でEC戦略や販促方針を決めながら、サイト管理・改善提案・実装支援を受けたい企業</td></tr>\n              <tr><th>最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- Growth OS -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Growth OS</h3>\n        </div>\n        <p class=\"solstar-maint-card__price\">330,000円〜<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">EC戦略から改善施策の実行まで伴走する上位プラン。売上やCVR、客単価などをもとに改善優先順位や月次ロードマップ設計に深く入り、施策提案・実装・検証まで支援します。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <tbody>\n              <tr><th>月間対応工数</th><td>30時間〜</td></tr>\n              <tr><th>主な目的</th><td>EC戦略＋改善実行伴走</td></tr>\n              <tr><th>対象</th><td>EC戦略、改善優先順位、施策実行まで外部パートナーと一緒に進めたい企業</td></tr>\n              <tr><th>最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 比較表 -->\n      <section class=\"solstar-maint-card solstar-maint-compare\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">サービス比較表</h3>\n        </div>\n        <div class=\"solstar-maint-compare__scroll\">\n          <table class=\"solstar-compare-table\">\n            <thead>\n              <tr>\n                <th>内容</th>\n                <th>Store Care</th>\n                <th>Growth Partner</th>\n                <th>Growth OS</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr><th>月額料金</th><td>22,000円（税込）</td><td>110,000円（税込）</td><td>330,000円〜（税込）</td></tr>\n              <tr><th>月間対応工数</th><td>2時間</td><td>10時間</td><td>30時間〜</td></tr>\n              <tr><th>主な目的</th><td>保守・軽微更新</td><td>サイト管理＋改善提案</td><td>EC戦略＋改善実行伴走</td></tr>\n              <tr><th>最低契約期間</th><td>3ヶ月</td><td>3ヶ月</td><td>3ヶ月</td></tr>\n              <tr><th>サイト改善提案</th><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>チャットサポート</th><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>デザイン修正</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>商品登録点数</th><td><span class=\"solstar-mark-no\">—</span></td><td>月20点まで</td><td>月50点まで</td></tr>\n              <tr><th>定例MTG</th><td><span class=\"solstar-mark-no\">—</span></td><td>月1回</td><td>月1回</td></tr>\n              <tr><th>データ分析</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>戦略設計への関与</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>改善ロードマップ作成</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th>広告運用</th><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th>SNS運用代行</th><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th>記事制作</th><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th>動画制作</th><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 表記・工数について -->\n      <section class=\"solstar-maint-card solstar-maint-note\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">表記・月間対応工数について</h3>\n        </div>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <tbody>\n              <tr><th>◯</th><td>各プランの月間対応工数の範囲内で対応します</td></tr>\n              <tr><th>別途有料</th><td>月額プランには含まれず、別途お見積もりとなります</td></tr>\n              <tr><th>—</th><td>対応対象外です</td></tr>\n              <tr><th>応相談</th><td>内容・規模により個別に判断します</td></tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"solstar-maint-text\" style=\"margin-top:14px;\">月間対応工数には、調査、要件整理、実装、修正、検証、レポート作成、MTG、ディレクション、チャット対応を含みます。月間対応工数を超える作業が発生する場合は、事前にご相談のうえ、11,000円（税込）/ 時間で追加対応します。未消化の対応工数は、原則として翌月へ繰り越しできません。</p>\n      </section>\n\n    </div>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 70
      }
    },

    "section_custom_code_kkwVXf": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<section class=\"solstar-express\">\n  <div class=\"solstar-express__inner\">\n    <header class=\"solstar-express__header\">\n      <h2 class=\"solstar-express__title\">SOLSTAR EXPRESS</h2>\n\n      <p class=\"solstar-express__sub\">\n        EC担当者を採用する前に、外部EC事業部として活用したいメーカー様へ\n      </p>\n    </header>\n\n    <div class=\"solstar-express__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-card solstar-service\">\n        <h3 class=\"solstar-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <caption class=\"visually-hidden\">サービス基本情報</caption>\n            <tbody>\n              <tr><th scope=\"row\">納期目安</th><td>約2〜4週間</td></tr>\n              <tr>\n                <th scope=\"row\">料金</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>初期費用：55,000円（税込）</li>\n                    <li>月額36,500円（税込）\n〜</li>\n           \n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">SOLSTAR販売運営分</th>\n                <td>\n                  <span class=\"solstar-fee-inline\">\n                    <span>販売価格の最大20%</span>\n                  </span>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">メーカー様受取分</th><td>販売価格の80%以上</td></tr>\n              <tr><th scope=\"row\">精算</th><td>月末締め・翌月に商品仕入代金としてお支払い</td></tr>\n              <tr><th scope=\"row\">販売形態</th><td>購入者から見た販売者はSOLSTAR。メーカー様はSOLSTARへ商品を供給・発送</td></tr>\n              <tr><th scope=\"row\">対象</th><td>商品はあるが、ECサイト制作・運用・販売管理にリソースを割けないメーカー様</td></tr>\n              <tr><th scope=\"row\">契約期間</th><td>6〜12ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 初期費用に含まれる内容 -->\n      <section class=\"solstar-card solstar-initial\">\n        <h3 class=\"solstar-card__title\">初期費用に含まれる内容</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <caption class=\"visually-hidden\">初期費用に含まれる内容</caption>\n            <tbody>\n              <tr><th scope=\"row\">コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th scope=\"row\">要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr>\n                <th scope=\"row\">ECサイトセットアップ</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>基本情報・ページ設定</li>\n                    <li>決済／配送／税設定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">サイトデザイン制作</th><td>各ページのデザイン調整</td></tr>\n              <tr>\n                <th scope=\"row\">各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>商品登録（5点）</li>\n                    <li>カテゴリー登録（3点）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">LP制作（1ページ）</th><td>構成設計／デザイン反映／CTA設計</td></tr>\n              <tr>\n                <th scope=\"row\">テスト・公開</th>\n                <td>\n                  <ul class=\"solstar-table-list\">\n                    <li>購入テスト・表示確認（PC / Mobile）</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 月々のECサイト運用内容 -->\n      <section class=\"solstar-card solstar-monthly\">\n        <h3 class=\"solstar-card__title\">月々のECサイト運用内容</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <caption class=\"visually-hidden\">月々のECサイト運用内容</caption>\n            <tbody>\n              <tr>\n                <th scope=\"row\">商品登録</th>\n                <td>月5点まで。商品登録・更新に対応</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">サイトデザイン修正</th>\n                <td>月5回まで。バナー差し替えや文言調整などの軽微な修正</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">ECサイトの不具合対応</th>\n                <td>表示崩れや動作不具合など対応</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">購入者対応の一次窓口</th>\n                <td>購入者からのお問い合わせ・発送通知など、購入者対応の一次窓口をSOLSTARが担当</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">販売データの共有・改善提案</th>\n                <td>月次レポートで販売実績を共有し、商品ページ・訴求・キャンペーンの改善を提案</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-card solstar-client\">\n        <h3 class=\"solstar-card__title\">メーカー様にご対応いただくこと</h3>\n        <div class=\"solstar-table-wrap\">\n          <table class=\"solstar-table\">\n            <caption class=\"visually-hidden\">メーカー様にご対応いただくこと</caption>\n            <tbody>\n              <tr>\n                <th scope=\"row\">商品情報・素材の提供</th>\n                <td>商品情報、画像素材、スペックのご提供</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">在庫管理</th>\n                <td>商品在庫の管理</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">商品の発送</th>\n                <td>注文情報をもとに、購入者へ商品を発送</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">追跡番号の共有</th>\n                <td>発送後、追跡番号をSOLSTARへ共有</td>\n              </tr>\n              <tr>\n                <th scope=\"row\">商品専門の問い合わせ協力</th>\n                <td>商品専門知識が必要な問い合わせや、商品不良・誤配送などメーカー様起因の対応にご協力</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section class=\"solstar-card solstar-paid\">\n        <h3 class=\"solstar-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-table-list\">\n          <li>アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>バナー画像制作</li>\n          <li>独自機能開発</li>\n          <li>POS連携</li>\n        </ul>\n      </section>\n\n      <section class=\"solstar-card solstar-nosupport\">\n        <h3 class=\"solstar-card__title\">対応不可</h3>\n        <ul class=\"solstar-table-list\">\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n\n    <nav class=\"solstar-pricing-actions\" aria-label=\"SOLSTAR EXPRESSの関連リンク\">\n      <a class=\"btn btn--primary btn--solid\" href=\"{{ routes.root_url }}pages/solstar-express\">SOLSTAR EXPRESSの詳細を見る</a>\n    </nav>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 100,
        "padding_bottom": 50
      }

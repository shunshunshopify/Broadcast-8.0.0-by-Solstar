    "section_custom_code_k6cYGG": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n/* ===========================\n   SOLSTAR – Pro Plan (Isolated)\n   ※ solstar-standard / solstar-basic と干渉しない完全別prefix\n   =========================== */\n.solstar-pro {\n  /* scheme-10 */\n  --sp-text: #fcfbf9;          /* section_text */\n  --sp-bg: #0d0326;            /* section_bg */\n  --sp-card: #f5f2ec;          /* section_bg_light */\n  --sp-line: #d1cdc4;          /* lines_and_border */\n  --sp-accent: #665035;\n  --sp-link: #ffffff;\n\n  color: var(--sp-text);\n  background: var(--sp-bg);\n  padding: 0px 16px;\n}\n\n.solstar-pro__inner {\n  max-width: 1020px;\n  margin: 0 auto;\n}\n\n/* Header */\n.solstar-pro__header {\n  margin-bottom: 18px;\n}\n\n.solstar-pro__title {\n  font-size: 36px;\n  line-height: 1.15;\n  font-weight: 900;\n  margin: 0 0 10px;\n  color: var(--sp-text);\n}\n\n.solstar-pro__sub {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.9;\n  font-weight: 900;\n  color: var(--sp-text);\n}\n\n/* Layout */\n.solstar-pro__layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin-top: 18px;\n  align-items: stretch;\n}\n\n/* Card */\n.solstar-pro-card {\n  background: var(--sp-card);\n  border: 1px solid var(--sp-line);\n  border-radius: 16px;\n  padding: 18px;\n  min-width: 0;\n  color: #111111; /* ライト背景用の可読色 */\n}\n\n.solstar-pro-card__title {\n  margin: 0 0 14px;\n  font-size: 16px;\n  font-weight: 900;\n  line-height: 1.35;\n  color: #111111;\n}\n\n/* ===== Table ===== */\n.solstar-pro-table-wrap {\n  border: none;\n  border-radius: 14px;\n  overflow: hidden;\n  background: transparent;\n}\n\n.solstar-pro-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border: 1px solid var(--sp-line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--sp-card);\n  color: #111111;\n}\n\n.solstar-pro-table th,\n.solstar-pro-table td {\n  padding: 12px 14px;\n  border-top: 1px solid var(--sp-line);\n  vertical-align: middle;\n  text-align: left;\n  color: #111111;\n}\n\n.solstar-pro-table tr:first-child th,\n.solstar-pro-table tr:first-child td {\n  border-top: none;\n}\n\n.solstar-pro-table th {\n  width: 34%;\n  font-size: 12px;\n  font-weight: 700;\n  white-space: nowrap;\n  border-right: 1px solid var(--sp-line);\n  background: rgba(120, 120, 120, 0.14);\n}\n\n.solstar-pro-table td {\n  font-size: 14px;\n  line-height: 1.7;\n  word-break: break-word;\n}\n\n/* ===========================\n   ★ 構築内容：長文Wrap対応\n   =========================== */\n.solstar-pro-scope .solstar-pro-table th,\n.solstar-pro-scope .solstar-pro-table td {\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n/* ===========================\n   ★ お客様に対応いただくこと：長文Wrap対応\n   =========================== */\n.solstar-pro-client .solstar-pro-table th,\n.solstar-pro-client .solstar-pro-table td {\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n/* ===== Lists ===== */\n.solstar-pro-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 1.2em;\n  color: #111111;\n}\n\n.solstar-pro-list li {\n  margin-top: 6px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n.solstar-pro-list li:first-child {\n  margin-top: 0;\n}\n\n/* Bullet OFF (only inside tables) */\n.solstar-pro-table .solstar-pro-list {\n  list-style: none;\n  padding-left: 0;\n  margin-left: 0;\n}\n.solstar-pro-table .solstar-pro-list li {\n  margin-left: 0;\n}\n\n/* Link（保険） */\n.solstar-pro a {\n  color: var(--sp-link);\n}\n\n/* Desktop */\n@media (min-width: 860px) {\n  .solstar-pro {\n    padding: 0px 24px;\n  }\n\n  .solstar-pro__layout {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .solstar-pro-service { grid-column: 1; grid-row: 1; }\n  .solstar-pro-scope   { grid-column: 2; grid-row: 1; }\n  .solstar-pro-client  { grid-column: 1; grid-row: 2; }\n  .solstar-pro-paid    { grid-column: 2; grid-row: 2; }\n  .solstar-pro-nosup   { grid-column: 1; grid-row: 3; }\n\n  .solstar-pro-table th {\n    width: 32%;\n  }\n}\n\n/* Small screens */\n@media (max-width: 420px) {\n  .solstar-pro-table th {\n    width: 38%;\n    white-space: normal;\n  }\n}\n\n</style>\n\n<section class=\"solstar-pro\">\n  <div class=\"solstar-pro__inner\">\n    <header class=\"solstar-pro__header\">\n      <h2 class=\"solstar-pro__title\">Proプラン</h2>\n      <p class=\"solstar-pro__sub\">大規模EC・基幹システム連携を前提に、事業基盤から再構築したい方へ</p>\n    </header>\n\n    <div class=\"solstar-pro__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-pro-card solstar-pro-service\">\n        <h3 class=\"solstar-pro-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-pro-table-wrap\">\n          <table class=\"solstar-pro-table\">\n            <tbody>\n              <tr><th>納期</th><td>12〜24週間</td></tr>\n              <tr><th>価格</th><td>お問い合わせ</td></tr>\n              <tr><th>体制</th><td>ディレクター2名＋エンジニア2名</td></tr>\n              <tr><th>対象</th><td>商品数や業務が増え、基幹連携を含めた再構築を検討している方</td></tr>\n\n              <tr>\n                <th>進捗打合せ回数</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>週1回</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr>\n                <th>納品物</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>構築済み御社ECストア</li>\n                    <li>管理画面・テーマ権限一式</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr>\n                <th>修正・変更ルール</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>5回まで</li>\n                    <li>※大幅変更は別途お見積り</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 構築内容 -->\n      <section class=\"solstar-pro-card solstar-pro-scope\">\n        <h3 class=\"solstar-pro-card__title\">構築内容</h3>\n        <div class=\"solstar-pro-table-wrap\">\n          <table class=\"solstar-pro-table\">\n            <tbody>\n              <tr><th>コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th>要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr>\n                <th>ECサイトセットアップ</th>\n                <td>基本情報・ページ設定／決済6点（QRコード決済、銀行振込決済、PayPal、Paidy、Komojuなど）・配送・税設定</td>\n              </tr>\n              <tr>\n                <th>サイトデザイン制作</th>\n                <td>各ページのデザイン調整／複数テンプレート作成／バナー画像制作（15点）／GTM設定</td>\n              </tr>\n              <tr>\n                <th>各種データ登録</th>\n                <td>商品登録（1000点）／カテゴリー登録（50点）／既存ECからの主要データ移行（100件）</td>\n              </tr>\n              <tr><th>アプリ連携</th><td>15点</td></tr>\n              <tr>\n                <th>外部システム連携</th>\n                <td>ERP／在庫管理／受注管理等とのAPI・CSV連携の設計・実装・検証</td>\n              </tr>\n              <tr><th>オリジナルページ制作</th><td>10ページ</td></tr>\n              <tr><th>テスト・公開</th><td>購入テスト・表示確認（PC／Mobile）</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと（差し替え済み） -->\n      <section class=\"solstar-pro-card solstar-pro-client\">\n        <h3 class=\"solstar-pro-card__title\">お客様にご対応いただくこと</h3>\n        <div class=\"solstar-pro-table-wrap\">\n          <table class=\"solstar-pro-table\">\n            <tbody>\n              <tr>\n                <th>素材・ドメイン準備</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>商品情報・画像素材のご提供</li>\n                    <li>ドメインの準備</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr>\n                <th>情報共有</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>基幹システム（ERP／在庫／受注管理等）の仕様共有</li>\n                    <li>API・CSV連携に必要な情報のご提供</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr>\n                <th>方針・意思決定</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>掲載コンテンツ原稿のご用意</li>\n                    <li>週1回の定例ミーティングご参加</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr>\n                <th>公開後の運用</th>\n                <td>\n                  <ul class=\"solstar-pro-list\">\n                    <li>受注・出荷・カスタマーサポート対応</li>\n                    <li>ECサイトの運用・更新</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 別途有料対応 -->\n      <section class=\"solstar-pro-card solstar-pro-paid\">\n        <h3 class=\"solstar-pro-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-pro-list\">\n          <li>保守運用サポート</li>\n          <li>追加アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>追加バナー画像制作</li>\n          <li>越境対応</li>\n          <li>POS連携</li>\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n\n      <!-- 対応不可 -->\n      <section class=\"solstar-pro-card solstar-pro-nosup\">\n        <h3 class=\"solstar-pro-card__title\">対応不可</h3>\n        <ul class=\"solstar-pro-list\">\n          <li>基幹システム自体の再構築</li>\n        </ul>\n      </section>\n    </div>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 70
      }

      "settings": {
        "code": "<section class=\"solstar-basic\">\n  <div class=\"solstar-basic__inner\">\n    <header class=\"solstar-basic__header\">\n      <h2 class=\"solstar-basic__title\">Basicプラン</h2>\n      <p class=\"solstar-basic__sub\">小規模・少数SKUで、ブランドの世界観を育てながら運用したい方へ</p>\n    </header>\n\n    <div class=\"solstar-basic__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-basic-card solstar-basic-service\">\n        <h3 class=\"solstar-basic-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <caption class=\"visually-hidden\">サービス基本情報</caption>\n            <tbody>\n              <tr><th scope=\"row\">納期</th><td>約4〜8週間</td></tr>\n              <tr><th scope=\"row\">価格</th><td>1,100,000円（税込）〜</td></tr>\n              <tr><th scope=\"row\">体制</th><td>ディレクター1名＋エンジニア1名</td></tr>\n              <tr><th scope=\"row\">対象</th><td>少人数体制で、自社ECをこれから本格運用していきたい方</td></tr>\n              <tr>\n                <th scope=\"row\">進捗打合せ回数</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>3回（要件・構築内容・公開前の確認）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">納品物</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>構築済み御社ECストア</li>\n                    <li>管理画面・テーマ権限一式</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">修正・変更ルール</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>3回まで</li>\n                    <li>※大幅変更は別途お見積り</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 構築内容 -->\n      <section class=\"solstar-basic-card solstar-basic-scope\">\n        <h3 class=\"solstar-basic-card__title\">構築内容</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <caption class=\"visually-hidden\">構築内容</caption>\n            <tbody>\n              <tr><th scope=\"row\">コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th scope=\"row\">要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr>\n                <th scope=\"row\">ECサイトセットアップ</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>基本情報・ページ設定</li>\n                    <li>決済／配送／税設定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">サイトデザイン制作</th><td>各ページのデザイン調整</td></tr>\n\n              <tr>\n                <th scope=\"row\">各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-basic-list\">\n                    <li>商品登録（20点）</li>\n                    <li>カテゴリー登録（6点）</li>\n                  </ul>\n                </td>\n              </tr>\n\n              <tr><th scope=\"row\">アプリ連携</th><td>3点</td></tr>\n              <tr><th scope=\"row\">オリジナルページ制作</th><td>3ページ</td></tr>\n              <tr><th scope=\"row\">テスト・公開</th><td>購入テスト・表示確認（PC / Mobile）</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-basic-card solstar-basic-client\">\n        <h3 class=\"solstar-basic-card__title\">お客様にご対応いただくこと</h3>\n        <div class=\"solstar-basic-table-wrap\">\n          <table class=\"solstar-basic-table\">\n            <caption class=\"visually-hidden\">お客様にご対応いただくこと</caption>\n            <tbody>\n              <tr><th scope=\"row\">素材・ドメイン準備</th><td>キービジュアル、商品情報、画像素材および、ドメインのご準備</td></tr>\n              <tr><th scope=\"row\">コンテンツ提供</th><td>コンテンツ原稿のご用意</td></tr>\n              <tr><th scope=\"row\">ECサイト運用</th><td>ECサイト納品後の運用・更新</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 別途有料対応 -->\n      <section class=\"solstar-basic-card solstar-basic-paid\">\n        <h3 class=\"solstar-basic-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-basic-list\">\n          <li>保守運用サポート</li>\n          <li>追加アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>バナー画像制作</li>\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>POS連携</li>\n        </ul>\n      </section>\n\n      <!-- 対応不可 -->\n      <section class=\"solstar-basic-card solstar-basic-nosup\">\n        <h3 class=\"solstar-basic-card__title\">対応不可</h3>\n        <ul class=\"solstar-basic-list\">\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n\n    <nav class=\"solstar-pricing-actions\" aria-label=\"Basicプランの関連リンク\">\n      <a class=\"btn btn--primary btn--solid\" href=\"{{ routes.root_url }}pages/shopify-ec-store-basic-plan\">Basicプランの詳細を見る</a>\n    </nav>\n  </div>\n</section>",

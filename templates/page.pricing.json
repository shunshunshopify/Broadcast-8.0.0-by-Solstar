    "section_custom_code_PYAnkJ": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n/* ===========================\n   SOLSTAR – Standard Plan (Isolated)\n   ※ solstar-basic / solstar-express と干渉しない完全別prefix\n   =========================== */\n.solstar-standard {\n  /* scheme-10 */\n  --ss-text: #fcfbf9;          /* section_text */\n  --ss-bg: #0d0326;            /* section_bg */\n  --ss-card: #f5f2ec;          /* section_bg_light */\n  --ss-line: #d1cdc4;          /* lines_and_border */\n  --ss-accent: #665035;\n  --ss-link: #ffffff;\n\n  color: var(--ss-text);\n  background: var(--ss-bg);\n  padding: 0px 16px;\n}\n\n.solstar-standard__inner {\n  max-width: 1020px;\n  margin: 0 auto;\n}\n\n/* Header */\n.solstar-standard__header {\n  margin-bottom: 18px;\n}\n\n.solstar-standard__title {\n  font-size: 36px;\n  line-height: 1.15;\n  font-weight: 900;\n  margin: 0 0 10px;\n  color: var(--ss-text);\n}\n\n.solstar-standard__sub {\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.9;\n  font-weight: 900;\n  color: var(--ss-text);\n}\n\n/* Layout */\n.solstar-standard__layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  margin-top: 18px;\n  align-items: stretch;\n}\n\n/* Card */\n.solstar-standard-card {\n  background: var(--ss-card);\n  border: 1px solid var(--ss-line);\n  border-radius: 16px;\n  padding: 18px;\n  min-width: 0;\n  color: #111111; /* ライト背景の可読性優先 */\n}\n\n.solstar-standard-card__title {\n  margin: 0 0 14px;\n  font-size: 16px;\n  font-weight: 900;\n  line-height: 1.35;\n  color: #111111;\n}\n\n/* ===== Table ===== */\n.solstar-standard-table-wrap {\n  border: none;\n  border-radius: 14px;\n  overflow: hidden;\n  background: transparent;\n}\n\n.solstar-standard-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  border: 1px solid var(--ss-line);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--ss-card);\n  color: #111111;\n}\n\n.solstar-standard-table th,\n.solstar-standard-table td {\n  padding: 12px 14px;\n  border-top: 1px solid var(--ss-line);\n  vertical-align: middle;\n  text-align: left;\n  color: #111111;\n}\n\n.solstar-standard-table tr:first-child th,\n.solstar-standard-table tr:first-child td {\n  border-top: none;\n}\n\n.solstar-standard-table th {\n  width: 34%;\n  font-size: 12px;\n  font-weight: 700;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  border-right: 1px solid var(--ss-line);\n  background: rgba(120, 120, 120, 0.14);\n}\n\n.solstar-standard-table td {\n  font-size: 14px;\n  line-height: 1.7;\n  word-break: break-word;\n}\n\n/* ===========================\n   ★ 構築内容のみ 長文Wrap対応\n   =========================== */\n.solstar-standard-scope .solstar-standard-table th,\n.solstar-standard-scope .solstar-standard-table td {\n  white-space: normal;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n}\n\n/* ===== Lists ===== */\n.solstar-standard-list {\n  list-style: disc;\n  margin: 0;\n  padding-left: 1.2em;\n  color: #111111;\n}\n\n.solstar-standard-list li {\n  margin-top: 6px;\n  font-size: 14px;\n  line-height: 1.7;\n}\n.solstar-standard-list li:first-child {\n  margin-top: 0;\n}\n\n.solstar-standard-list li.solstar-standard-note {\n  color: rgba(17, 17, 17, 0.62);\n  font-size: 10px;\n  line-height: 1.65;\n}\n\n/* Bullet OFF (only inside tables) */\n.solstar-standard-table .solstar-standard-list {\n  list-style: none;\n  padding-left: 0;\n  margin-left: 0;\n}\n.solstar-standard-table .solstar-standard-list li {\n  margin-left: 0;\n}\n\n/* Link（保険） */\n.solstar-standard a {\n  color: var(--ss-link);\n}\n\n/* Desktop */\n@media (min-width: 860px) {\n  .solstar-standard {\n    padding: 0px 24px;\n  }\n\n  .solstar-standard__layout {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 18px;\n  }\n\n  .solstar-standard-service { grid-column: 1; grid-row: 1; }\n  .solstar-standard-scope   { grid-column: 2; grid-row: 1; }\n  .solstar-standard-client  { grid-column: 1; grid-row: 2; }\n  .solstar-standard-nosup   { grid-column: 2; grid-row: 2; }\n  .solstar-standard-paid    { grid-column: 1 / -1; grid-row: 3; }\n\n  .solstar-standard-table th {\n    width: 32%;\n  }\n\n  .solstar-standard-card {\n    padding: 22px;\n  }\n\n  .solstar-standard-paid .solstar-standard-list {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-template-rows: repeat(6, auto);\n    grid-auto-flow: column;\n    column-gap: 28px;\n    row-gap: 0;\n  }\n\n  .solstar-standard-paid .solstar-standard-list li {\n    break-inside: avoid;\n  }\n}\n\n/* Small screens */\n@media (max-width: 420px) {\n  .solstar-standard-table th {\n    width: 38%;\n    white-space: normal;\n  }\n}\n\n</style>\n\n<section class=\"solstar-standard\">\n  <div class=\"solstar-standard__inner\">\n    <header class=\"solstar-standard__header\">\n      <h2 class=\"solstar-standard__title\">Standardプラン</h2>\n      <p class=\"solstar-standard__sub\">BASE・STORESなどから次の成長基盤へ移行し、ブランド表現・CRM・運用効率を整えたいD2Cブランドへ。Shopifyを活用し、ブランドの世界観、購入導線、商品管理、リピート施策の土台を整えるリニューアル・移行プランです。</p>\n    </header>\n\n    <div class=\"solstar-standard__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-standard-card solstar-standard-service\">\n        <h3 class=\"solstar-standard-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <tbody>\n              <tr><th>納期目安</th><td>約8〜12週間</td></tr>\n              <tr><th>価格</th><td>2,200,000円（税込）〜</td></tr>\n              <tr><th>体制</th><td>ディレクター1名＋エンジニア2名</td></tr>\n              <tr>\n                <th>こんな課題におすすめ</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>BASE・STORESでは、ブランド表現や商品管理に限界を感じている</li>\n                    <li>リピート購入、カゴ落ち対策、再入荷通知、LINE導線などCRM施策を強化したい</li>\n                    <li>Shopify移行時の商品データ・SEO評価の引き継ぎや、公開後の社内運用に不安がある</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>進捗打合せ回数</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>5回（要件・構築内容・公開前の確認）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>納品物</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>構築済み御社ECストア</li>\n                    <li>管理画面・テーマ権限一式</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>修正・変更ルール</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>3回まで</li>\n                    <li>※大幅変更は別途お見積り</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 構築内容 -->\n      <section class=\"solstar-standard-card solstar-standard-scope\">\n        <h3 class=\"solstar-standard-card__title\">構築内容</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <tbody>\n              <tr><th>コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th>要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr><th>ECサイトセットアップ</th><td>基本情報・ページ設定／決済・配送・税設定</td></tr>\n              <tr>\n                <th>サイトデザイン制作</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>自社テーマを土台に、ブランドの世界観に合わせた各ページのデザイン調整</li>\n                    <li>商品詳細・コレクションページのテンプレート作成</li>\n                    <li>バナー画像制作（3点）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>商品データ登録・移行（100点まで）</li>\n                    <li>カテゴリー・コレクション設計（20件まで）</li>\n                    <li>主要ページ・基本データの移行（20件まで）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th>アプリ連携</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>6点</li>\n                    <li class=\"solstar-standard-note\">例：レビュー、再入荷通知、カゴ落ち対策、LINE連携、サイズガイド、レコメンド、メール配信、SEO補助など、事業内容に合わせて選定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th>オリジナルページ制作</th><td>6ページ</td></tr>\n              <tr>\n                <th>SEO移行の基本対応</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>主要URLの確認</li>\n                    <li>リダイレクト方針の整理</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th>計測タグ設定</th><td>GA4 / Search Console / Metaピクセル等の基本設定確認</td></tr>\n              <tr><th>検証</th><td>機能確認・テスト購入（PC／Mobile）</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-standard-card solstar-standard-client\">\n        <h3 class=\"solstar-standard-card__title\">お客様にご対応いただくこと</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <tbody>\n              <tr><th>素材・ドメイン準備</th><td>キービジュアル、商品情報、画像素材、ドメイン</td></tr>\n              <tr><th>コンテンツ提供</th><td>コンテンツ原稿のご用意</td></tr>\n              <tr><th>ECサイト運用</th><td>納品後の運用・更新</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 別途有料対応 -->\n      <section class=\"solstar-standard-card solstar-standard-paid\">\n        <h3 class=\"solstar-standard-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-standard-list\">\n          <li>保守運用サポート</li>\n          <li>追加アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>追加バナー画像制作</li>\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>POS連携</li>\n          <li>大量URLの301リダイレクト設計・設定</li>\n          <li>詳細なSEO設計</li>\n          <li>ブログ記事・コラム記事の大量移行</li>\n          <li>Search Consoleを使った公開後モニタリング強化</li>\n          <li>高度な分析ダッシュボード作成・広告運用分析</li>\n        </ul>\n      </section>\n\n      <!-- 対応不可 -->\n      <section class=\"solstar-standard-card solstar-standard-nosup\">\n        <h3 class=\"solstar-standard-card__title\">対応不可</h3>\n        <ul class=\"solstar-standard-list\">\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n  </div>\n</section>\n",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 50
      }

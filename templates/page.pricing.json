    "section_custom_code_jsonld_pricing": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Organization\",\n      \"@id\": \"https://www.solstar.co.jp/#organization\",\n      \"name\": \"株式会社SOLSTAR\",\n      \"alternateName\": \"SOLSTAR\",\n      \"url\": \"https://www.solstar.co.jp/\",\n      \"description\": \"Shopifyを専門に、ブランドの成長フェーズに合わせたECサイトの構築・運営を支援する会社です。\",\n      \"sameAs\": [\n        \"https://www.instagram.com/solstar_official\",\n        \"https://www.youtube.com/@solstar-official\"\n      ]\n    },\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://www.solstar.co.jp/#website\",\n      \"url\": \"https://www.solstar.co.jp/\",\n      \"name\": \"株式会社SOLSTAR\",\n      \"publisher\": {\n        \"@id\": \"https://www.solstar.co.jp/#organization\"\n      },\n      \"inLanguage\": \"ja\"\n    },\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"https://www.solstar.co.jp/pages/pricing#webpage\",\n      \"url\": \"https://www.solstar.co.jp/pages/pricing\",\n      \"name\": \"料金プラン｜Shopify ECサイト構築・制作・保守運用｜株式会社SOLSTAR\",\n      \"description\": \"SOLSTARのShopify ECサイト構築・制作プラン（Basic／Standard／Pro）と、保守運用プラン（Store Care／Growth Partner／Growth OS）の料金・対応内容をご案内します。\",\n      \"isPartOf\": {\n        \"@id\": \"https://www.solstar.co.jp/#website\"\n      },\n      \"about\": [\n        {\n          \"@id\": \"https://www.solstar.co.jp/pages/pricing#service-build\"\n        },\n        {\n          \"@id\": \"https://www.solstar.co.jp/pages/pricing#service-maintenance\"\n        }\n      ],\n      \"mainEntity\": [\n        {\n          \"@id\": \"https://www.solstar.co.jp/pages/pricing#service-build\"\n        },\n        {\n          \"@id\": \"https://www.solstar.co.jp/pages/pricing#service-maintenance\"\n        }\n      ],\n      \"breadcrumb\": {\n        \"@id\": \"https://www.solstar.co.jp/pages/pricing#breadcrumb\"\n      },\n      \"inLanguage\": \"ja\"\n    },\n    {\n      \"@type\": \"Service\",\n      \"@id\": \"https://www.solstar.co.jp/pages/pricing#service-build\",\n      \"name\": \"Shopify ECサイト構築・制作\",\n      \"serviceType\": \"Shopify ECサイト構築・制作\",\n      \"category\": \"ECサイト構築サービス\",\n      \"url\": \"https://www.solstar.co.jp/pages/pricing\",\n      \"provider\": {\n        \"@id\": \"https://www.solstar.co.jp/#organization\"\n      },\n      \"areaServed\": {\n        \"@type\": \"Country\",\n        \"name\": \"日本\"\n      },\n      \"description\": \"Shopifyを活用したECサイトの構築・制作サービス。事業規模や移行要件に応じて、Basic／Standard／Proの3プランをご用意しています。\",\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"ECサイト構築・制作プラン\",\n        \"itemListElement\": [\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"https://www.solstar.co.jp/pages/pricing#offer-basic\",\n            \"name\": \"Basicプラン\",\n            \"url\": \"https://www.solstar.co.jp/pages/pricing\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"1100000\",\n            \"description\": \"小規模・少数SKUで、ブランドの世界観を育てながら運用したい方向けのShopify ECサイト構築プラン。価格は1,100,000円（税込）〜です。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"価格表記\",\n                \"value\": \"1,100,000円（税込）〜\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"納期\",\n                \"value\": \"約4〜8週間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"体制\",\n                \"value\": \"ディレクター1名＋エンジニア1名\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"進捗打合せ回数\",\n                \"value\": \"3回\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"修正・変更ルール\",\n                \"value\": \"3回まで（大幅変更は別途お見積り）\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"https://www.solstar.co.jp/pages/pricing#offer-standard\",\n            \"name\": \"Standardプラン\",\n            \"url\": \"https://www.solstar.co.jp/pages/pricing\",\n            \"priceCurrency\": \"JPY\",\n            \"price\": \"2200000\",\n            \"description\": \"BASE・STORESなどから次の成長基盤へ移行し、ブランド表現・CRM・運用効率を整えたいD2Cブランド向けのリニューアル・移行プラン。価格は2,200,000円（税込）〜です。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"価格表記\",\n                \"value\": \"2,200,000円（税込）〜\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"納期目安\",\n                \"value\": \"約8〜12週間\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"体制\",\n                \"value\": \"ディレクター1名＋エンジニア2名\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"進捗打合せ回数\",\n                \"value\": \"5回\"\n              },\n              {\n                \"@type\": \"PropertyValue\",\n                \"name\": \"修正・変更ルール\",\n                \"value\": \"3回まで（大幅変更は別途お見積り）\"\n              }\n            ]\n          },\n          {\n            \"@type\": \"Offer\",\n            \"@id\": \"https://www.solstar.co.jp/pages/pricing#offer-pro\",\n            \"name\": \"Proプラン\",\n            \"url\": \"https://www.solstar.co.jp/pages/pricing\",\n            \"priceCurrency\": \"JPY\",\n            \"description\": \"大規模EC・基幹システム連携を前提に、事業基盤から再構築したい方向けのプラン。価格はお問い合わせください。\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"additionalProperty\": [\n              {\n                \"@type\": \"PropertyValue\",\n              
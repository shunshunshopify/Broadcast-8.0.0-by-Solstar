    "section_custom_code_PYAnkJ": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<section class=\"solstar-standard\">\n  <div class=\"solstar-standard__inner\">\n    <header class=\"solstar-standard__header\">\n      <h2 class=\"solstar-standard__title\">Standardプラン</h2>\n      <p class=\"solstar-standard__sub\">BASE・STORESなどから次の成長基盤へ移行し、ブランド表現・CRM・運用効率を整えたいD2Cブランドへ。Shopifyを活用し、ブランドの世界観、購入導線、商品管理、リピート施策の土台を整えるリニューアル・移行プランです。</p>\n    </header>\n\n    <div class=\"solstar-standard__layout\">\n      <!-- サービス基本情報 -->\n      <section class=\"solstar-standard-card solstar-standard-service\">\n        <h3 class=\"solstar-standard-card__title\">サービス基本情報</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <caption class=\"visually-hidden\">サービス基本情報</caption>\n            <tbody>\n              <tr><th scope=\"row\">納期目安</th><td>約8〜12週間</td></tr>\n              <tr><th scope=\"row\">価格</th><td>2,200,000円（税込）〜</td></tr>\n              <tr><th scope=\"row\">体制</th><td>ディレクター1名＋エンジニア2名</td></tr>\n              <tr>\n                <th scope=\"row\">対象となる課題</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>BASE・STORESでは、ブランド表現や商品管理に限界を感じている</li>\n                    <li>リピート購入、カゴ落ち対策、再入荷通知、LINE導線などCRM施策を強化したい</li>\n                    <li>Shopify移行時の商品データ・SEO評価の引き継ぎや、公開後の社内運用に不安がある</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">進捗打合せ回数</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>5回（要件・構築内容・公開前の確認）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">納品物</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>構築済み御社ECストア</li>\n                    <li>管理画面・テーマ権限一式</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">修正・変更ルール</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>3回まで</li>\n                    <li>※大幅変更は別途お見積り</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 構築内容 -->\n      <section class=\"solstar-standard-card solstar-standard-scope\">\n        <h3 class=\"solstar-standard-card__title\">構築内容</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <caption class=\"visually-hidden\">構築内容</caption>\n            <tbody>\n              <tr><th scope=\"row\">コンセプト定義</th><td>ペルソナ整理／ブランドの方向性確認</td></tr>\n              <tr><th scope=\"row\">要件定義</th><td>事業内容・商品特性のヒアリング</td></tr>\n              <tr><th scope=\"row\">ECサイトセットアップ</th><td>基本情報・ページ設定／決済・配送・税設定</td></tr>\n              <tr>\n                <th scope=\"row\">サイトデザイン制作</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>自社テーマを土台に、ブランドの世界観に合わせた各ページのデザイン調整</li>\n                    <li>商品詳細・コレクションページのテンプレート作成</li>\n                    <li>バナー画像制作（3点）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">各種データ登録</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>商品データ登録・移行（100点まで）</li>\n                    <li>カテゴリー・コレクション設計（20件まで）</li>\n                    <li>主要ページ・基本データの移行（20件まで）</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr>\n                <th scope=\"row\">アプリ連携</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>6点</li>\n                    <li class=\"solstar-standard-note\">例：レビュー、再入荷通知、カゴ落ち対策、LINE連携、サイズガイド、レコメンド、メール配信、SEO補助など、事業内容に合わせて選定</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">オリジナルページ制作</th><td>6ページ</td></tr>\n              <tr>\n                <th scope=\"row\">SEO移行の基本対応</th>\n                <td>\n                  <ul class=\"solstar-standard-list\">\n                    <li>主要URLの確認</li>\n                    <li>リダイレクト方針の整理</li>\n                  </ul>\n                </td>\n              </tr>\n              <tr><th scope=\"row\">計測タグ設定</th><td>GA4 / Search Console / Metaピクセル等の基本設定確認</td></tr>\n              <tr><th scope=\"row\">検証</th><td>機能確認・テスト購入（PC／Mobile）</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- お客様に対応いただくこと -->\n      <section class=\"solstar-standard-card solstar-standard-client\">\n        <h3 class=\"solstar-standard-card__title\">お客様にご対応いただくこと</h3>\n        <div class=\"solstar-standard-table-wrap\">\n          <table class=\"solstar-standard-table\">\n            <caption class=\"visually-hidden\">お客様にご対応いただくこと</caption>\n            <tbody>\n              <tr><th scope=\"row\">素材・ドメイン準備</th><td>キービジュアル、商品情報、画像素材、ドメイン</td></tr>\n              <tr><th scope=\"row\">コンテンツ提供</th><td>コンテンツ原稿のご用意</td></tr>\n              <tr><th scope=\"row\">ECサイト運用</th><td>納品後の運用・更新</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 別途有料対応 -->\n      <section class=\"solstar-standard-card solstar-standard-paid\">\n        <h3 class=\"solstar-standard-card__title\">別途有料対応となる内容</h3>\n        <ul class=\"solstar-standard-list\">\n          <li>保守運用サポート</li>\n          <li>追加アプリ実装</li>\n          <li>追加ページ制作</li>\n          <li>追加バナー画像制作</li>\n          <li>越境対応</li>\n          <li>外部システム連携</li>\n          <li>POS連携</li>\n          <li>大量URLの301リダイレクト設計・設定</li>\n          <li>詳細なSEO設計</li>\n          <li>ブログ記事・コラム記事の大量移行</li>\n          <li>Search Consoleを使った公開後モニタリング強化</li>\n          <li>高度な分析ダッシュボード作成・広告運用分析</li>\n        </ul>\n      </section>\n\n      <!-- 対応不可 -->\n      <section class=\"solstar-standard-card solstar-standard-nosup\">\n        <h3 class=\"solstar-standard-card__title\">対応不可</h3>\n        <ul class=\"solstar-standard-list\">\n          <li>アプリ開発</li>\n        </ul>\n      </section>\n    </div>\n\n    <nav class=\"solstar-pricing-actions\" aria-label=\"Standardプランの関連リンク\">\n      <a class=\"btn btn--primary btn--solid\" href=\"{{ routes.root_url }}pages/standard-plan\">Standardプランの詳細を見る</a>\n    </nav>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 50
      }
    },
    "section_custom_code_Mn7Tcp": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<section class=\"solstar-maint\">\n  <div class=\"solstar-maint__inner\">\n    <header class=\"solstar-maint__header\">\n      <h2 class=\"solstar-maint__title\">保守運用プラン</h2>\n      <p class=\"solstar-maint__sub\">Shopify専門の知見をもとに、サイト保守から運用改善、EC戦略を含めた伴走支援まで、目的に応じた3つの保守運用プランをご用意しています。</p>\n    </header>\n\n    <div class=\"solstar-maint__layout\">\n      <!-- Store Care -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Store Care</h3>\n        </div>\n        <p class=\"solstar-maint-card__price\">22,000円<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">Shopifyやサイト運営の相談に回答し、課題に応じた改善案や施策をご案内するアドバイザリープラン。日々の運用・実装は自社で行い、必要なときに専門家へ相談したい企業に適しています。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <caption class=\"visually-hidden\">Store Care</caption>\n            <tbody>\n              <tr><th scope=\"row\">月間対応工数</th><td>2時間</td></tr>\n              <tr><th scope=\"row\">主な目的</th><td>運営相談＋改善・施策案内</td></tr>\n              <tr><th scope=\"row\">対象</th><td>日々の運用・実装は自社で行い、Shopifyやサイト改善について相談できる専門担当者を求める企業</td></tr>\n              <tr><th scope=\"row\">最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- Growth Partner -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Growth Partner</h3>\n        </div>\n        <p class=\"solstar-maint-card__price\">110,000円<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">サイト管理と改善提案・実装支援を行う運用改善プラン。SOLSTARが課題に応じたサイト改善提案、デザイン修正、商品登録、月1回の定例MTGを行い、月間対応工数の範囲内で実装まで支援します。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <caption class=\"visually-hidden\">Growth Partner</caption>\n            <tbody>\n              <tr><th scope=\"row\">月間対応工数</th><td>10時間</td></tr>\n              <tr><th scope=\"row\">主な目的</th><td>サイト管理＋改善提案</td></tr>\n              <tr><th scope=\"row\">対象</th><td>社内でEC戦略や販促方針を決めながら、サイト管理・改善提案・実装支援を受けたい企業</td></tr>\n              <tr><th scope=\"row\">最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- Growth OS -->\n      <section class=\"solstar-maint-card\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">Growth OS</h3>\n        </div>\n        <p class=\"solstar-maint-card__price\">330,000円<small>（税込）/ 月</small></p>\n        <p class=\"solstar-maint-card__desc\">EC戦略から改善施策の実行まで伴走する上位プラン。売上やCVR、客単価などをもとに改善優先順位や月次ロードマップ設計に深く入り、施策提案・実装・検証まで支援します。</p>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <caption class=\"visually-hidden\">Growth OS</caption>\n            <tbody>\n              <tr><th scope=\"row\">月間対応工数</th><td>30時間</td></tr>\n              <tr><th scope=\"row\">主な目的</th><td>EC戦略＋改善実行伴走</td></tr>\n              <tr><th scope=\"row\">対象</th><td>EC戦略、改善優先順位、施策実行まで外部パートナーと一緒に進めたい企業</td></tr>\n              <tr><th scope=\"row\">最低契約期間</th><td>3ヶ月</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 比較表 -->\n      <section class=\"solstar-maint-card solstar-maint-compare\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">サービス比較表</h3>\n        </div>\n        <div class=\"solstar-maint-compare__scroll\" tabindex=\"0\" role=\"region\" aria-label=\"保守運用プランのサービス比較表\">\n          <table class=\"solstar-compare-table\">\n            <caption class=\"visually-hidden\">サービス比較表</caption>\n            <thead>\n              <tr>\n                <th scope=\"col\">内容</th>\n                <th scope=\"col\">Store Care</th>\n                <th scope=\"col\">Growth Partner</th>\n                <th scope=\"col\">Growth OS</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr><th scope=\"row\">月額料金</th><td>22,000円（税込）</td><td>110,000円（税込）</td><td>330,000円（税込）</td></tr>\n              <tr><th scope=\"row\">月間対応工数</th><td>2時間</td><td>10時間</td><td>30時間</td></tr>\n              <tr><th scope=\"row\">主な目的</th><td>運営相談＋改善・施策案内</td><td>サイト管理＋改善提案</td><td>EC戦略＋改善実行伴走</td></tr>\n              <tr><th scope=\"row\">最低契約期間</th><td>3ヶ月</td><td>3ヶ月</td><td>3ヶ月</td></tr>\n              <tr><th scope=\"row\">サイト改善提案</th><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">チャットサポート</th><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">デザイン修正</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">商品登録点数</th><td><span class=\"solstar-mark-no\">—</span></td><td>月20点まで</td><td>月50点まで</td></tr>\n              <tr><th scope=\"row\">定例MTG</th><td><span class=\"solstar-mark-no\">—</span></td><td>月1回</td><td>月1回</td></tr>\n              <tr><th scope=\"row\">データ分析</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">戦略設計への関与</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">改善ロードマップ作成</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-yes\">◯</span></td></tr>\n              <tr><th scope=\"row\">広告運用</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th scope=\"row\">SNS運用</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th scope=\"row\">記事制作</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th scope=\"row\">動画制作</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n              <tr><th scope=\"row\">画像制作</th><td><span class=\"solstar-mark-no\">—</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td><td><span class=\"solstar-mark-paid\">別途有料</span></td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- 表記・工数について -->\n      <section class=\"solstar-maint-card solstar-maint-note\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 class=\"solstar-maint-card__title\">表記・月間対応工数について</h3>\n        </div>\n        <div class=\"solstar-maint-table-wrap\">\n          <table class=\"solstar-maint-table\">\n            <caption class=\"visually-hidden\">表記・月間対応工数について</caption>\n            <tbody>\n              <tr><th scope=\"row\">◯</th><td>各プランの月間対応工数の範囲内で対応します</td></tr>\n              <tr><th scope=\"row\">別途有料</th><td>月額プランには含まれず、別途お見積もりとなります</td></tr>\n              <tr><th scope=\"row\">—</th><td>対応対象外です</td></tr>\n              <tr><th scope=\"row\">応相談</th><td>内容・規模により個別に判断します</td></tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"solstar-maint-text\">月間対応工数には、各プランの対応範囲に含まれる調査、要件整理、実装、修正、検証、MTG、ディレクション、チャット対応を含みます。Store Careは相談対応と改善案・施策のご案内が対象で、実装作業は含みません。月間対応工数を超える作業は、事前にご相談のうえ11,000円（税込）/ 時間で追加対応します。未消化の対応工数は、原則として翌月へ繰り越しできません。</p>\n      </section>\n\n      <section class=\"solstar-maint-card solstar-maint-note solstar-pricing-faq\" aria-labelledby=\"pricing-faq-title\">\n        <div class=\"solstar-maint-card__head\">\n          <h3 id=\"pricing-faq-title\" class=\"solstar-maint-card__title\">保守運用プランのよくある質問</h3>\n        </div>\n        <details>\n          <summary>どのプランを選べばよいですか？</summary>\n          <p>相談や改善施策の案内を中心に受けたい場合はStore Care、サイト更新や商品登録などの実装支援まで必要な場合はGrowth Partner、データ分析や戦略設計から実行まで伴走してほしい場合はGrowth OSが適しています。</p>\n        </details>\n        <details>\n          <summary>Store Careにサイトの修正作業は含まれますか？</summary>\n          <p>含まれません。Store CareはShopifyやサイト運営に関する相談への回答、サイト改善案、施策のご案内を行うアドバイザリープランです。修正や実装が必要な場合は、Growth Partner以上をご検討ください。</p>\n        </details>\n        <details>\n          <summary>最低契約期間は何ヶ月ですか？</summary>\n          <p>Store Care、Growth Partner、Growth OSのいずれも最低契約期間は3ヶ月です。</p>\n        </details>\n        <details>\n          <summary>月間対応工数を超えた場合はどうなりますか？</summary>\n          <p>事前に作業内容と追加工数をご相談し、必要に応じて11,000円（税込）/ 時間で追加対応します。未消化の対応工数は原則として翌月へ繰り越しできません。</p>\n        </details>\n        <details>\n          <summary>広告運用やSNS運用、記事・画像・動画制作も依頼できますか？</summary>\n          <p>Growth PartnerとGrowth OSでは対応可能ですが、月額プランには含まれません。広告運用、SNS運用、記事制作、動画制作、画像制作は内容を確認のうえ別途お見積もりします。Store Careでは対応対象外です。</p>\n        </details>\n      </section>\n\n      <nav class=\"solstar-pricing-actions solstar-maint-note\" aria-label=\"保守運用プランのお問い合わせ\">\n        <a class=\"btn btn--primary btn--solid\" href=\"#ContactForm--contact_form_XtLXAm\">保守運用プランについて相談する</a>\n      </nav>\n    </div>\n  </div>\n</section>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 70
      }
    },

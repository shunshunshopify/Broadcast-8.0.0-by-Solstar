    "section_custom_code_bQCpin": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<style>\n  .modern-mvv-section {\n    background-color: #0D0326;\n    color: #ffffff;\n    padding: 100px 10%; /* 左右の余白を十分に確保 */\n    line-height: 1.6;\n    letter-spacing: 0 !important;\n  }\n\n  .mvv-container {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .mvv-block {\n    display: grid;\n    grid-template-columns: 180px 1fr; /* 見出し幅を固定して安定感を出す */\n    gap: 20px; /* 見出しと文章の距離を狭めました */\n    padding: 60px 0;\n    border-top: 1px solid rgba(255, 255, 255, 0.15);\n    opacity: 0;\n    transform: translateY(20px);\n    transition: all 0.8s ease-out;\n  }\n\n  .mvv-block:first-child {\n    border-top: none;\n    padding-top: 0;\n  }\n\n  .mvv-block.is-active {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .mvv-title {\n    font-size: 1.1rem;\n    font-weight: 700;\n    margin: 6px 0 0 0; /* 本文の1行目と高さを合わせる調整 */\n    color: rgba(255, 255, 255, 0.4);\n    text-transform: uppercase;\n  }\n\n  .mvv-content-wrap {\n    display: flex;\n    flex-direction: column;\n    gap: 12px; /* キャッチコピーと本文の隙間もタイトに調整 */\n  }\n\n  .mvv-h2 {\n    font-size: clamp(1.4rem, 3.5vw, 2rem);\n    font-weight: 600;\n    margin: 0;\n    line-height: 1.3;\n    color: #ffffff;\n  }\n\n  .mvv-description {\n    font-size: 0.95rem;\n    color: rgba(255, 255, 255, 0.75);\n    margin: 0;\n    text-align: justify;\n  }\n\n  @media (max-width: 768px) {\n    .modern-mvv-section {\n      padding: 60px 8%;\n    }\n    .mvv-block {\n      grid-template-columns: 1fr;\n      gap: 10px; /* スマホ時もタイトに */\n      padding: 40px 0;\n    }\n    .mvv-title {\n      font-size: 0.9rem;\n      margin-top: 0;\n    }\n    .mvv-h2 {\n      font-size: 1.3rem;\n    }\n  }\n</style>\n\n<section class=\"modern-mvv-section\">\n  <div class=\"mvv-container\">\n    \n    <div class=\"mvv-block\">\n      <h2 class=\"mvv-title\">Mission</h2>\n      <div class=\"mvv-content-wrap\">\n        <p class=\"mvv-h2\">誰もが、無理なく成長できるECを。</p>\n        <p class=\"mvv-description\">\n          私たちのミッションは、ブランドのビジョンや大切にしている価値観を理解し、限られた予算や体制の中でも、継続的に売上を積み上げていけるECを実現することです。<br><br>\n          作って終わるECではなく、事業として育て、運用し続けられるECを通じて、ブランドの成長に継続的に寄り添います。\n        </p>\n      </div>\n    </div>\n\n    <div class=\"mvv-block\">\n      <h2 class=\"mvv-title\">Vision</h2>\n      <div class=\"mvv-content-wrap\">\n        <p class=\"mvv-h2\">日本発ブランドを、世界へ。</p>\n        <p class=\"mvv-description\">\n          私たちは、日本発ブランドが国内での成功にとどまらず、世界市場でも事業として成立するECを構築できるよう支援します。<br><br>\n          2030年までに、年商1億円以上を達成する100のブランドを輩出し、日本発のEC成功モデルを世界へ広げることを目指します。\n        </p>\n      </div>\n    </div>\n\n    <div class=\"mvv-block\">\n      <h2 class=\"mvv-title\">Value</h2>\n      <div class=\"mvv-content-wrap\">\n        <p class=\"mvv-h2\">ブランドの魅力を、成果につながる形へ</p>\n        <p class=\"mvv-description\">\n          私たちは、ブランドの背景や大切にしている価値観を理解したうえで、その魅力が正しく伝わり、運用し続けられるECを設計します。<br><br>\n          デザイン性や機能性も大切にしながら、事業フェーズに応じて本当に必要な構成を見極め、無駄な開発や過剰な投資を抑えます。<br><br>\n          成果につながる構成と運用を重視し、事業者のビジョンに寄り添うパートナーとして、ECの成長に向き合い続けます。\n        </p>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n  const mvvObserver = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('is-active');\n      }\n    });\n  }, { threshold: 0.1 });\n\n  document.querySelectorAll('.mvv-block').forEach(el => mvvObserver.observe(el));\n</script>",
        "width": "wrapper--full",
        "color_scheme": "scheme-10",
        "padding_top": 0,
        "padding_bottom": 0
      }

    "section_accordion_cream_faq": {
      "type": "section-accordion-group",
      "blocks": {
        "subheading_cream": {
          "type": "subheading",
          "settings": {
            "title": "FAQ"
          }
        },
        "heading_cream": {
          "type": "heading",
